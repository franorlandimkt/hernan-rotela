---
/**
 * Para quién es / para quién no es: dos columnas de celdas (filtra antes del formulario). Abajo, la segunda
 * línea del negocio: planos a distancia para todo el país y el exterior (id "a-distancia").
 * Textos: landing.ts → fit y remote.
 */
import HeadRow from "../grid/HeadRow.astro";
import EndRow from "../grid/EndRow.astro";
import Icon from "../illustrations/Icon.astro";
import { fit as t, remote } from "../../content/landing";
---

<section class="fit" id="para-quien" aria-labelledby="fit-title">
  <HeadRow label={t.label} title={t.h2} id="fit-title" />
  <div class="g">
    <div class="stack s-3 st-3 fit__col">
      <div class="cell cell--glow fit__head reveal" style="--glow-at:0% 0%;--glow-size:120% 160%;--glow-a:.35">
        <h3 class="t-h3">{t.yesTitle}</h3>
      </div>
      {
        t.yes.map((y) => (
          <div class="cell fit__item reveal">
            <Icon name="check" size={20} class="fit__ico fit__ico--yes" />
            <p>{y}</p>
          </div>
        ))
      }
    </div>
    <div class="stack s-3 st-3 fit__col">
      <div class="cell cell--alt fit__head reveal">
        <h3 class="t-h3">{t.noTitle}</h3>
      </div>
      {
        t.no.map((n) => (
          <div class="cell cell--alt fit__item reveal">
            <Icon name="x" size={20} class="fit__ico" />
            <p>{n}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="g" id="a-distancia">
    <div class="cell s-2 st-6 cell--split reveal">
      <p class="cell__label cell__label--sq etiqueta">{remote.label}</p>
      <p class="dato fit__tag">{remote.tag}</p>
    </div>
    <div class="cell s-4 st-6 reveal">
      <h3 class="t-h3">{remote.h2}</h3>
      <p>{remote.text}</p>
      <p class="fit__muted">{remote.note}</p>
    </div>
  </div>
  <EndRow label={t.cta} cta="para-quien" note={t.note} />
</section>

<style>
  .fit__col > .fit__item {
    flex-grow: 1;
  }
  .fit__head {
    padding-block: 1.125rem;
  }
  .fit__item {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.875rem;
  }
  .fit__item :global(.fit__ico) {
    margin-top: 0.2em;
    color: var(--tinta-2);
  }
  .fit__item :global(.fit__ico--yes) {
    color: var(--ladrillo-texto);
  }
  .fit__tag {
    color: var(--ladrillo-texto);
  }
  .fit__muted {
    color: var(--tinta-2);
  }
  @media (max-width: 767px) {
    .fit__col + .fit__col {
      margin-top: calc(var(--gap) * 3);
    }
  }
</style>
