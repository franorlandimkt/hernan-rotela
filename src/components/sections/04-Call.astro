---
/**
 * La videollamada (la oferta de la web): qué se lleva la persona en esos minutos con Hernán.
 * Izquierda: los 4 puntos, numerados. Derecha: la "ventana" de la videollamada (foto de Hernán si existe
 * src/assets/img/hernan-llamada.*, si no el perfil de la marca) con su ficha: duración, costo, con quién, dónde.
 * La ilustración muestra cómo es la llamada: él, vos y el proyecto en pantalla.
 */
import SectionHead from "../ui/SectionHead.astro";
import Rotulo from "../ui/Rotulo.astro";
import Img from "../ui/Img.astro";
import Icon from "../illustrations/Icon.astro";
import { call as t } from "../../content/landing";
import { site } from "../../data/site";
import { hasImg, DEV } from "../../lib/images";

const photo = hasImg(t.photo);
---

<section class="section s-hueso call" id="videollamada" aria-labelledby="call-title">
  <div class="container">
    <SectionHead label={t.label} title={t.h2} sub={t.sub} id="call-title" />
    <div class="call__grid">
      <ol class="call__list">
        {
          t.items.map((it, i) => (
            <li class="call__item reveal" style={`--delay:${i * 0.06}s`}>
              <span class="call__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="t-h3 call__title">{it.title}</h3>
                <p>{it.text}</p>
              </div>
              <span class="call__ico ico-box--dark" aria-hidden="true">
                <Icon name={it.icon} size={24} />
              </span>
            </li>
          ))
        }
      </ol>

      <aside class="call__card reveal" aria-label={t.card.tag}>
        <div class="call__win theme-dark">
          <div class="call__bar">
            <span class="call__lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="etiqueta">{t.card.tag}</span>
          </div>
          <div class="call__screen">
            {
              photo ? (
                <Img name={t.photo} alt={t.photoAlt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 36vw, 100vw" class="call__photo" aspect="16/10" />
              ) : (
                <div class="call__nophoto" aria-hidden="true">
                  <img src={site.logo.isoInverse} alt="" width="120" height="96" loading="lazy" decoding="async" />
                </div>
              )
            }
            {!photo && DEV && <p class="slot-dev call__dev">Falta la foto: src/assets/img/{t.photo}.jpg</p>}
            <p class="call__host">
              <strong>{t.card.host}</strong>
              <span class="etiqueta">{t.card.hostRole}</span>
            </p>
            <span class="call__pip" aria-hidden="true">
              <Icon name="people" size={20} />
              <span class="etiqueta">{t.card.you}</span>
            </span>
            <span class="call__share" aria-hidden="true">
              <svg viewBox="0 0 96 60" fill="none">
                <rect x="6" y="6" width="84" height="48" />
                <path d="M6 30h30M48 30h42M40 6v14M40 42v12M66 30v24" />
                <path class="acc" d="M6 58h84" />
              </svg>
              <span class="etiqueta">{t.card.screen}</span>
            </span>
          </div>
        </div>
        <Rotulo items={t.card.rows} class="call__rotulo" />
        <p class="call__partner t-small">
          <Icon name="people" size={18} />
          <span>{t.card.partner}</span>
        </p>
      </aside>
    </div>

    <div class="call__cta reveal">
      <a class="btn btn--lg" href="#cotiza" data-cta="videollamada">
        {t.cta}
        <Icon name="arrow-right" size={20} class="arrow" />
      </a>
      <p class="t-small call__note">{t.ctaNote}</p>
    </div>
  </div>
</section>

<style>
  .call__grid {
    display: grid;
    gap: var(--space-5);
  }
  .call__list {
    list-style: none;
    display: grid;
    border-top: 1.5px solid var(--tinta);
  }
  .call__item {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--linea);
  }
  .call__n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--c-ladrillo);
    color: var(--c-white);
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: var(--fs-dato);
  }
  .call__item p {
    margin-top: 0.375rem;
    color: var(--tinta-2);
    max-width: 34rem;
  }
  .call__ico {
    display: none;
  }

  /* ---- Ventana de la videollamada ---- */
  .call__card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    --call-shadow: var(--c-ladrillo);
    padding-right: 10px;
  }
  .call__win {
    border: 1.5px solid var(--c-grafito);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--c-grafito);
    color: var(--c-hueso);
    box-shadow: 10px 10px 0 var(--call-shadow);
  }
  .call__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--linea);
  }
  .call__bar .etiqueta {
    color: var(--c-hueso);
    font-size: 0.6875rem;
  }
  .call__lights {
    display: inline-flex;
    gap: 0.3125rem;
  }
  .call__lights i {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--tinta-2);
  }
  .call__lights i:first-child {
    background: var(--c-ladrillo);
    border-color: var(--c-ladrillo);
  }
  .call__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(70% 70% at 50% 55%, rgb(214 58 31 / 0.38), transparent 72%),
      linear-gradient(to right, #2a2927 1px, transparent 1px) center / 24px 24px,
      linear-gradient(to bottom, #2a2927 1px, transparent 1px) center / 24px 24px,
      #1a1918;
  }
  .call__screen :global(.call__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .call__nophoto {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .call__nophoto img {
    width: clamp(4.5rem, 22%, 7rem);
    height: auto;
    opacity: 0.9;
  }
  .call__dev {
    position: absolute;
    inset: 0.5rem auto auto 0.5rem;
    color: var(--c-hueso);
    padding: 0.375rem 0.5rem;
    font-size: 0.6875rem;
  }
  .call__host {
    position: absolute;
    left: 0.625rem;
    bottom: 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.4375rem 0.625rem;
    background: rgb(22 22 22 / 0.82);
    border-left: 3px solid var(--c-ladrillo);
    font-size: var(--fs-small);
    line-height: 1.3;
    max-width: 62%;
  }
  .call__host .etiqueta {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--tinta-2);
  }
  .call__pip,
  .call__share {
    position: absolute;
    right: 0.625rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    width: 26%;
    max-width: 7.5rem;
    background: var(--c-grafito);
    border: 1px solid var(--c-hueso);
    border-radius: var(--radius-sm);
    color: var(--c-hueso);
  }
  .call__pip {
    top: 0.625rem;
    aspect-ratio: 4 / 3;
  }
  .call__share {
    bottom: 0.625rem;
    padding: 0.375rem 0.375rem 0.3125rem;
  }
  .call__share svg {
    width: 100%;
    height: auto;
    stroke: var(--c-hueso);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .call__share svg .acc {
    stroke: var(--c-ladrillo);
  }
  .call__pip .etiqueta,
  .call__share .etiqueta {
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    color: var(--tinta-2);
  }
  .call__rotulo {
    margin-top: var(--space-2);
  }
  .call__partner {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    color: var(--tinta-2);
  }
  .call__partner :global(.ico) {
    margin-top: 0.1rem;
    color: var(--ladrillo-texto);
  }
  .call__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .call__note {
    color: var(--tinta-2);
  }
  @media (max-width: 479px) {
    .call__cta .btn {
      width: 100%;
    }
    .call__share {
      display: none;
    }
  }
  @media (min-width: 640px) {
    .call__ico {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--c-grafito);
      border-radius: var(--radius-sm);
    }
  }
  @media (min-width: 1024px) {
    .call__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-6);
      align-items: start;
    }
    .call__card {
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
    }
    .call__cta {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }
  }
</style>
