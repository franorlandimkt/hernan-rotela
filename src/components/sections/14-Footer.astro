---
/**
 * Pie en celdas: logo inverso + nombre y título (sin matrícula ni colegio) · base y redes con URL · política
 * de privacidad y copyright. En el celular y la tablet (sin rieles) suma la celda con los datos de los rieles:
 * hora local, WhatsApp, TikTok, ubicación y la credencial. Funciona dentro del marco (home) y suelto (blog,
 * privacidad).
 */
import Logo from "../ui/Logo.astro";
import Icon from "../illustrations/Icon.astro";
import { footer as t, frame } from "../../content/landing";
import { site, socialList, waLink } from "../../data/site";

const year = new Date().getFullYear();
const nets = socialList();
const wa = waLink("Hola Hernán, vengo de la web.");
const tiktok = site.social.tiktok.url;
---

<footer class="ft">
  <div class="g">
    <div class="cell s-2 st-3 cell--split ft__brand">
      <Logo tone="light" width={180} />
      <p class="ft__who">{site.person} · {site.credential}</p>
    </div>
    <div class="cell s-2 st-3 cell--split">
      <p class="cell__label etiqueta">{t.base}</p>
      {
        nets.length > 0 && (
          <nav class="ft__social" aria-label={t.socialTitle}>
            <ul>
              {nets.map(([key, s]) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.name}${s.followers ? `, ${s.followers} ${t.followers}` : ""}`}>
                    <Icon name={key} size={18} />
                    {s.followers && <span class="dato">{s.followers}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
    <div class="cell s-2 st-6 cell--alt ft__rails">
      <p class="cell__label etiqueta">{t.dataTitle}</p>
      <ul class="ft__list">
        <li class="ft__clock">
          <span class="ft__dot" aria-hidden="true"></span>
          {`${frame.clock} `}
          <time data-clock>{frame.clockZone}</time>
        </li>
        <li>{wa ? <a href={wa} target="_blank" rel="noopener">{frame.whatsapp}</a> : frame.whatsapp}</li>
        <li>{tiktok ? <a href={tiktok} target="_blank" rel="noopener">{frame.tiktok}</a> : frame.tiktok}</li>
        <li>{frame.place}</li>
        {frame.right.slice(0, -1).map((r) => <li>{r}</li>)}
      </ul>
    </div>
    <div class="cell s-6 st-6 cell--alt cell--split ft__legal">
      <a class="ft__privacy" href="/politica-de-privacidad">{t.privacy}</a>
      <p class="ft__copy">© {year} {site.brandFull}. {t.rights}</p>
    </div>
  </div>
</footer>

<style>
  .ft {
    padding: var(--gap) var(--gap) calc(var(--gap) + var(--cookie-h, 0px));
    background: var(--linea);
  }
  :global(.frame) .ft {
    margin-top: var(--gap);
    padding: 0;
  }
  .ft__brand {
    gap: var(--space-5);
  }
  .ft__who {
    color: var(--tinta-2);
  }
  .ft__social ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ft__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: var(--radius-md);
    background: var(--superficie);
    text-decoration: none;
  }
  .ft__list {
    list-style: none;
    display: grid;
    gap: 0.375rem;
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
  .ft__list a {
    color: var(--tinta);
  }
  .ft__dot {
    display: inline-block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin-right: 0.375rem;
    border-radius: 50%;
    background: var(--c-ladrillo);
  }
  .ft__clock time {
    color: var(--tinta);
  }
  .ft__legal {
    gap: var(--space-3);
  }
  .ft__privacy {
    color: var(--tinta);
    font-weight: 600;
  }
  .ft__copy {
    font-size: var(--fs-small);
    color: var(--tinta-2);
  }
  /* Con rieles (≥1024 en la home) los datos ya están a los costados: el pie queda en una fila de 6 */
  @media (min-width: 1024px) {
    :global(.frame) .ft__rails {
      display: none;
    }
    :global(.frame) .ft__legal {
      grid-column: span 2;
    }
  }
</style>
