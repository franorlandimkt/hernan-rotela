---
/**
 * Imagen responsive: toma un archivo de src/assets/img/ por nombre (sin extensión)
 * y genera <picture> con AVIF + WebP, srcset, width/height y lazy por defecto.
 * Para reemplazar un placeholder: poné la foto real con el MISMO nombre en src/assets/img/.
 *
 * Lightbox: con `lightbox="<galería>"` la imagen se puede tocar para verla en grande (Lightbox.astro),
 * con un ícono de "ampliar" en la esquina. Todas las imágenes con la misma galería se pasan deslizando,
 * en el orden de la página. "Quiero algo así" del lightbox abre el formulario con el botón de origen
 * "render" (form-steps.ts → CTA_ORIGINS). Solo material propio de Hernán.
 */
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../illustrations/Icon.astro";
import { lightbox as lbCopy } from "../../content/landing";

interface Props {
  name: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  aspect?: string;
  lightbox?: string;
}
const { name, alt, widths = [400, 800, 1200], sizes = "(min-width: 1024px) 50vw, 100vw", priority = false, class: cls, aspect, lightbox } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/img/*.{jpg,jpeg,png,webp}", { eager: true });
const key = Object.keys(files).find((k) => k.split("/").pop()!.replace(/\.\w+$/, "") === name);
if (!key) throw new Error(`Imagen "${name}" no encontrada en src/assets/img/`);
const src = files[key].default;
const w = widths.filter((x) => x <= src.width);
// Versión grande para el lightbox (WebP, hasta 1600 px de ancho)
const big = lightbox ? await getImage({ src, width: Math.min(1600, src.width), format: "webp" }) : null;
---

{
  big ? (
    <button
      type="button"
      class="lb-trigger"
      data-lightbox={lightbox}
      data-lb-src={big.src}
      data-lb-alt={alt}
      aria-label={`${lbCopy.open}: ${alt}`}
    >
      <Picture
        src={src}
        alt={alt}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={w.length ? w : [src.width]}
        sizes={sizes}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : undefined}
        class={cls}
        style={aspect ? `aspect-ratio:${aspect};object-fit:cover` : undefined}
      />
      <span class="lb-badge" aria-hidden="true">
        <Icon name="expand" size={16} />
      </span>
    </button>
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={w.length ? w : [src.width]}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : undefined}
      class={cls}
      style={aspect ? `aspect-ratio:${aspect};object-fit:cover` : undefined}
    />
  )
}
