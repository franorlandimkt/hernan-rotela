const body = icons[name];
if (!body) throw new Error(`Icon "${name}" no existe en Icon.astro`);
---

<svg
  class:list={["ico", cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={body} />
</svg>
