  whatsapp: `<path d="M4 20.5l1.3-4A8.5 8.5 0 1 1 8.4 19.3z"/><path d="M9 8.5c.2 2.6 3.5 6 6.3 6.4l1-1.4-1.9-1-1 .9c-1-.4-2.1-1.5-2.5-2.5l.9-1-1-1.9z"/>`,
