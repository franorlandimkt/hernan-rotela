---
/**
 * Hero: etiqueta (nombre + título), único H1, bajada, datos en mono, CTA al formulario y la línea de
 * planos a distancia. A la derecha (desktop) o debajo (celular), la "lámina": fachada de línea con cotas y el
 * rótulo de carátula de tu casa. Sin fotos: no hay material propio todavía, y lo gráfico sale de un plano.
 * Clases .hero__list (la bajada) / .hero__offer (los datos) / .hero__ctas: las usa el VideoDock en el
 * celular para acomodarse al lado de los datos, sin tapar la bajada ni el botón.
 */
import Marked from "../ui/Marked.astro";
import Rotulo from "../ui/Rotulo.astro";
import Icon from "../illustrations/Icon.astro";
import { hero as t } from "../../content/landing";
---

<section class="hero s-grid" aria-labelledby="hero-title">
  <div class="container hero__in">
    <div class="hero__copy">
      <p class="etiqueta hero__label">{t.label}</p>
      <h1 id="hero-title" class="t-display hero__title"><Marked text={t.h1} /></h1>
      <div class="hero__list">
        <p class="t-body-lg hero__sub">{t.sub}</p>
      </div>
      <div class="hero__row">
        <ul class="hero__offer dato" aria-label="Datos">
          {t.proof.map((p) => <li>{p}</li>)}
        </ul>
        <!-- Celular: lugar reservado para el video flotante (VideoDock), así no tapa texto ni el botón -->
        <div class="hero__slot" data-vd-slot aria-hidden="true"></div>
      </div>
      <div class="hero__ctas">
        <a class="btn btn--lg" href="#cotiza" data-cta="hero">
          {t.ctaPrimary}
          <Icon name="arrow-right" size={20} class="arrow" />
        </a>
        <a class="btn btn--lg btn--ghost hero__second" href="#como-trabajo">{t.ctaSecondary}</a>
      </div>
      <p class="hero__note etiqueta">{t.ctaNote}</p>
      <p class="hero__remote t-small">
        {t.remote} <a class="link" href="#a-distancia">{t.remoteLink}</a>
      </p>
    </div>

    <figure class="hero__sheet" aria-label={t.sheetLabel}>
      <svg class="hero__draw" viewBox="0 0 480 300" role="img" aria-label={t.drawingTitle}>
        <title>{t.drawingTitle}</title>
        <!-- nivel de terreno -->
        <line class="ln" x1="20" y1="230" x2="460" y2="230"></line>
        <line class="ln thin" x1="20" y1="238" x2="460" y2="238" stroke-dasharray="2 6"></line>
        <!-- volumen alto (dos plantas, techo a un agua) -->
        <polyline class="ln thick" points="70,230 70,118 260,60 260,230"></polyline>
        <!-- volumen bajo -->
        <polyline class="ln thick" points="260,130 400,170 400,230"></polyline>
        <!-- aberturas -->
        <rect class="ln" x="100" y="150" width="56" height="44"></rect>
        <line class="ln thin" x1="128" y1="150" x2="128" y2="194"></line>
        <rect class="ln" x="186" y="150" width="46" height="80"></rect>
        <rect class="ln" x="290" y="180" width="80" height="30"></rect>
        <line class="ln thin" x1="330" y1="180" x2="330" y2="210"></line>
        <!-- entrepiso -->
        <line class="ln thin" x1="70" y1="140" x2="260" y2="140" stroke-dasharray="6 4"></line>
        <!-- cota horizontal (la de ladrillo: una por pantalla) -->
        <g class="cota-svg">
          <line x1="70" y1="262" x2="400" y2="262"></line>
          <line x1="64" y1="268" x2="76" y2="256"></line>
          <line x1="394" y1="268" x2="406" y2="256"></line>
          <line class="ext" x1="70" y1="236" x2="70" y2="270"></line>
          <line class="ext" x1="400" y1="236" x2="400" y2="270"></line>
        </g>
        <text x="235" y="284" text-anchor="middle">16.50</text>
        <!-- cota vertical (tinta) -->
        <g class="cota-ink">
          <line x1="40" y1="118" x2="40" y2="230"></line>
          <line x1="34" y1="124" x2="46" y2="112"></line>
          <line x1="34" y1="236" x2="46" y2="224"></line>
        </g>
        <text x="30" y="178" text-anchor="middle" transform="rotate(-90 30 178)">6.20</text>
        <text x="456" y="222" text-anchor="end">±0.00</text>
        <text x="410" y="50" text-anchor="end">FACHADA · 1:100</text>
      </svg>
      <Rotulo items={t.sheet} class="hero__rotulo" />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.75rem, 1rem + 3vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .hero__in {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .hero__label {
    margin-bottom: var(--space-3);
  }
  .hero__title {
    max-width: 15ch;
  }
  .hero__list {
    margin-top: var(--space-4);
  }
  .hero__sub {
    max-width: 38rem;
    color: var(--tinta-2);
  }
  .hero__offer {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin-top: var(--space-4);
    color: var(--tinta);
  }
  .hero__offer li {
    display: flex;
    align-items: center;
  }
  .hero__offer li + li::before {
    content: "·";
    margin-inline: 0.625rem;
    color: var(--ladrillo-texto);
  }
  .hero__slot {
    display: none;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .hero__note {
    margin-top: var(--space-3);
  }
  .hero__remote {
    margin-top: var(--space-4);
    color: var(--tinta-2);
    max-width: 36rem;
  }

  /* ---- Lámina ---- */
  .hero__sheet {
    margin: 0;
    background: var(--superficie);
    border: 1px solid var(--tinta);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }
  .hero__draw {
    width: 100%;
    height: auto;
  }
  .hero__draw .ln {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }
  .hero__draw .thick {
    stroke-width: 2.5;
  }
  .hero__draw .thin {
    stroke-width: 1;
    stroke: var(--tinta-2);
  }
  .hero__draw .cota-svg line {
    stroke: var(--c-ladrillo);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .hero__draw .cota-svg .ext,
  .hero__draw .cota-ink line {
    stroke: var(--tinta-2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .hero__draw text {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    fill: var(--tinta-2);
  }
  .hero__rotulo {
    margin-top: var(--space-3);
  }

  /* ---- Celular: los datos en columna (al lado queda lugar para el video flotante) ---- */
  @media (max-width: 767px) {
    .hero__offer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }
    .hero__offer li + li::before {
      content: none;
    }
    .hero__offer li {
      padding-left: 0.875rem;
      border-left: 2px solid var(--c-ladrillo);
    }
    .hero__row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-3);
      margin-top: var(--space-4);
    }
    .hero__row .hero__offer {
      margin-top: 0;
    }
    .hero__slot {
      display: block;
      flex: none;
      width: 6rem;
      aspect-ratio: 9 / 16;
    }
    .hero__ctas .btn:first-child {
      width: 100%;
    }
    .hero__second {
      display: none;
    }
    .hero__draw text {
      font-size: 14px;
    }
  }
  @media (min-width: 1024px) {
    .hero__in {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-6);
    }
    .hero__title {
      max-width: 16ch;
    }
  }
</style>
