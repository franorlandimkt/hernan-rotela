        document.addEventListener("visibilitychange", () => document.visibilityState === "hidden" && backup());
        backups.push(backup);
        sendLead(payload, SEND_BUDGET_MS, endpoint)
          .then((r) => {
            settled = r !== "fail";
            if (settled) clearPending(key);
            else backup();
          })
          .catch(() => {});
      }
    }
    /** Respaldos del envío: también corren al tocar un link que saca de la página (WhatsApp). */
    const backups: (() => void)[] = [];
    const runBackups = () => backups.forEach((b) => b());

    // ---------- Agenda (pantalla final) ----------
    /**
     * Días y horarios libres del calendario de GHL (función ghl-booking), en la hora local de la persona.
     * Elige uno, confirma y la cita se crea con los datos del formulario (no los vuelve a escribir).
     * Si los horarios no cargan o la cita falla: el calendario de GHL (iframe con los datos precargados) si
     * hay link; el WhatsApp si hay número; si no hay ninguno de los dos, success.noCalendar.
     */
    function setupBooking(calUrl: string, lead: Record<string, unknown>, silent: boolean, test: boolean) {
      const s = copy.success;
      const frame = done.querySelector<HTMLIFrameElement>("[data-cal-frame]")!;
      const picker = done.querySelector<HTMLElement>("[data-book]")!;
      const msg = done.querySelector<HTMLElement>("[data-book-msg]")!;
      const daysEl = done.querySelector<HTMLElement>("[data-days]")!;
      const slotsEl = done.querySelector<HTMLElement>("[data-slots]")!;
      const go = done.querySelector<HTMLButtonElement>("[data-book-go]")!;
      const nowa = done.querySelector<HTMLElement>("[data-nowa]")!;
      let tz = DEFAULT_TZ;
      try {
        tz = Intl.DateTimeFormat().resolvedOptions().timeZone || tz;
      } catch {}
      const f = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("es-AR", { timeZone: tz, ...o });
      const zona = f({ timeZoneName: "long" }).formatToParts(new Date()).find((p) => p.type === "timeZoneName")?.value || tz;
      const time = (d: Date) => f({ hour: "numeric", minute: "2-digit" }).format(d).replace(/[  ]/g, " ");
      const short = (d: Date) => `${f({ weekday: "short", day: "numeric", month: "short" }).format(d)} · ${time(d)}`;
      done.querySelector<HTMLElement>("[data-tz]")!.textContent = s.calendarTz.replace("{zona}", zona);
      const slotsLabel = done.querySelector<HTMLElement>("[data-slots-label]")!;
      const keyOf = (d: Date) => {
        const p = f({ year: "numeric", month: "2-digit", day: "2-digit" })
          .formatToParts(d)
          .reduce((o, x) => ({ ...o, [x.type]: x.value }), {} as Record<string, string>);
        return `${p.year}-${p.month}-${p.day}`;
      };
      /** "domingo 1 de noviembre" (sin coma). */
      const long = (d: Date) => `${f({ weekday: "long" }).format(d)} ${f({ day: "numeric", month: "long" }).format(d)}`;

      let chosen = "";
      let busy = false;
      /** Veces seguidas que GHL dijo "ocupado": a la segunda, el respaldo (no elige horarios para siempre). */
      let taken = 0;
      const press = (wrap: HTMLElement, btn: HTMLElement) => wrap.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      function fallback() {
        picker.hidden = true;
        msg.textContent = s.calendarError;
        if (calUrl) {
          if (frame.src !== calUrl) frame.src = calUrl;
          frame.hidden = false;
        }
        if (site.whatsapp) nowa.hidden = false;
        if (!calUrl && !site.whatsapp) msg.textContent = s.noCalendar;
      }
      function pickSlot(btn: HTMLButtonElement, iso: string) {
        // ClickAgendar: la primera vez que elige un horario (una vez por sesión, nunca en modo prueba)
        if (!silent) trackOnce("agendar", "ClickAgendar");
        chosen = iso;
        press(slotsEl, btn);
        go.disabled = false;
        go.textContent = s.calendarConfirm.replace("{fecha}", short(new Date(iso)));
      }
      function pickDay(btn: HTMLButtonElement, list: string[], when: string) {
        press(daysEl, btn);
        slotsLabel.textContent = s.calendarSlots.replace("{cuando}", when);
        chosen = "";
        go.disabled = true;
        go.textContent = s.calendarPick;
        slotsEl.replaceChildren(
          ...list.map((iso) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "lf-slot";
            b.setAttribute("aria-pressed", "false");
            b.textContent = time(new Date(iso));
            b.addEventListener("click", () => pickSlot(b, iso));
            return b;
          }),
        );
      }
      async function load() {
        picker.hidden = true;
        msg.textContent = s.calendarLoading;
        try {
          const r = await fetch(`${endpoints.booking}?tz=${encodeURIComponent(tz)}`, { signal: AbortSignal.timeout?.(12000) });
          const out = (await r.json()) as { ok?: boolean; slots?: Record<string, string[]> };
          const days = Object.entries(out.slots ?? {})
            .filter(([, l]) => Array.isArray(l) && l.length)
            .sort(([a], [b]) => a.localeCompare(b));
          if (!r.ok || !out.ok || !days.length) throw 0;
          // El primer bloque siempre es Hoy: si hoy no hay horarios, sale apagado ("Sin horarios"); lo mismo
          // mañana si tampoco hay. Después, los días con horarios.
          const now = new Date();
          const today = keyOf(now);
          const tomorrow = keyOf(new Date(now.getTime() + 864e5));
          const name = (k: string, d: Date) => (k === today ? s.dayToday : k === tomorrow ? s.dayTomorrow : f({ weekday: "short" }).format(d).replace(".", ""));
          const face = (k: string, d: Date, extra = "") => `<small>${name(k, d)}</small><strong>${f({ day: "numeric" }).format(d)}</strong><small>${f({ month: "short" }).format(d).replace(".", "")}</small>${extra}`;
          const off: HTMLElement[] = [];
          for (const [k, d] of [
            [today, now],
            [tomorrow, new Date(now.getTime() + 864e5)],
          ] as const) {
            if (days[0][0] <= k) break;
            const el = document.createElement("span");
            el.className = "lf-day lf-day--off";
            el.innerHTML = face(k, d, `<em>${s.dayNone}</em>`);
            el.setAttribute("role", "img");
            el.setAttribute("aria-label", s.dayNoneLabel.replace("{fecha}", `${name(k, d)}, ${long(d)}`));
            off.push(el);
          }
          const btns = days.map(([k, list]) => {
            const d = new Date(list[0]);
            const when = k === today ? s.todayWord : k === tomorrow ? s.tomorrowWord : s.otherDay.replace("{fecha}", `${f({ weekday: "long" }).format(d)} ${f({ day: "numeric" }).format(d)}`);
            const b = document.createElement("button");
            b.type = "button";
            b.className = k === today || k === tomorrow ? "lf-day lf-day--near" : "lf-day";
            b.setAttribute("aria-pressed", "false");
            b.innerHTML = face(k, d);
            b.setAttribute("aria-label", k === today || k === tomorrow ? `${name(k, d)}, ${long(d)}` : long(d));
            b.addEventListener("click", () => pickDay(b, list, when));
            return { b, list, when };
          });
          daysEl.replaceChildren(...off, ...btns.map((x) => x.b));
          pickDay(btns[0].b, btns[0].list, btns[0].when);
          msg.textContent = "";
          picker.hidden = false;
        } catch {
          fallback();
        }
      }
      go.addEventListener("click", async () => {
        if (!chosen || busy) return;
        busy = true;
        go.disabled = true;
        go.textContent = s.calendarBooking;
        let res = "fail";
        try {
          const r = await fetch(endpoints.booking, {
            method: "POST",
            keepalive: true,
            headers: { "Content-Type": "text/plain;charset=UTF-8" },
            body: JSON.stringify({
              nombre: lead.nombre,
              email: lead.email,
              pais_codigo: lead.pais_codigo,
              whatsapp_num: lead.whatsapp_num,
              provincia: lead.provincia,
              hr_k9: lead.hr_k9,
              prueba: test,
              start: chosen,
              tz,
            }),
          });
          res = r.ok ? "ok" : r.status === 409 ? "taken" : "fail";
        } catch {}
        busy = false;
        if (res === "ok") {
          // Meta: evento estándar Schedule, una sola vez (nunca en modo prueba: tracking.ts lo frena)
          if (!silent) track("Schedule", newEventId());
          busy = true;
          const q = new URLSearchParams({ cuando: chosen, tz });
          if (test) q.set("modo", "prueba");
          // el nombre va al mensaje de WhatsApp de esa página (en la pestaña, nunca en la URL)
          try {
            sessionStorage.setItem("hr_nombre", String(lead.nombre));
          } catch {
            /* storage bloqueado: el mensaje sale sin el nombre */
          }
          runBackups();
          // un instante de espera deja salir el evento del Pixel
          setTimeout(() => location.assign(`/llamada-agendada?${q}`), 300);
        } else if (res === "taken" && ++taken < 2) {
          await load();
          msg.textContent = s.calendarTaken;
        } else fallback();
      });

      void load();
    }

    /**
     * Después de enviar (el lead ya salió): "Calculando…" QUOTE_LOADING_MS y el precio según m² y etapas
     * (form-steps.ts → quoteFor). Con lote, arriba de la agenda; sin lote, con las redes y sin agenda.
     * Pixel CotizacionVista al mostrar el precio, una vez por sesión (nunca en modo prueba ni con honeypot).
     */
    function showQuoteFlow(a: FlowAnswers, silent: boolean, land: boolean) {
      const q = copy.quote;
      const quoteData = quoteFor(a.m2, a.etapas);
      const target = land ? done : quote;
      const amounts: HTMLElement[] = [];
      const values: number[] = [];
      const money = (n: number) => {
        const el = document.createElement("span");
        el.textContent = usd(n);
        amounts.push(el);
        values.push(n);
        return el;
      };
      const amountEl = target.querySelector<HTMLElement>("[data-quote-amount]")!;
      if (quoteData?.kind === "range") {
        // "USD 8.000 – USD 11.500": si no entra en una línea, corta antes del guion
        const second = document.createElement("span");
        second.append("– ", money(quoteData.max!));
        amountEl.replaceChildren(money(quoteData.min!), " ", second);
      } else if (quoteData?.kind === "upTo") amountEl.replaceChildren(`${q.upTo} `, money(quoteData.max!));
      else if (quoteData?.kind === "from") amountEl.replaceChildren(`${q.from} `, money(quoteData.min!));
      else amountEl.replaceChildren();
      const m2 = a.m2 ? a.m2.charAt(0).toLowerCase() + a.m2.slice(1) : "";
      const etapa = etapaOf(a.etapas);
      target.querySelector<HTMLElement>("[data-quote-meta]")!.textContent = q.meta.replace("{m2}", m2).replace("{etapas}", etapa?.wa ?? (a.etapas || "").toLowerCase());

      calc.hidden = false;
      calc.classList.add("is-on");
      calc.focus({ preventScroll: true });
      toTop();
      setTimeout(() => {
        calc.hidden = true;
        target.classList.add("lf-reveal");
        target.hidden = false;
        target.focus({ preventScroll: true });
        toTop();
        countUp(amounts, values);
        if (!silent) trackOnce("cotizacion", "CotizacionVista", { m2: a.m2 ?? "", etapas: a.etapas ?? "" });
      }, QUOTE_LOADING_MS);
    }

    /** Los montos suben hasta el valor final (~0.8 s). El texto final ya está puesto: si algo falla, queda ese. */
    function countUp(els: HTMLElement[], to: number[]) {
      if (reduce() || !els.length) return;
      const t0 = performance.now();
      const D = 800;
      const frame = (now: number) => {
        const k = Math.min(1, (now - t0) / D);
        const e = 1 - (1 - k) ** 3;
        // arranca en el 80 % (mismas cifras: el renglón no cambia de ancho) y sube de 50 en 50
        els.forEach((el, i) => (el.textContent = usd(k < 1 ? Math.round((to[i] * (0.8 + 0.2 * e)) / 50) * 50 : to[i])));
        if (k < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }

    function submit() {
      if (finished || !validate(cur)) return;
      finished = true;
      clearState();
      const sentAt = Date.now();

      normalizePhone();
      // código del selector + número nacional: el servidor arma el E.164 (+5491123456789)
      const phone = readPhone(tel.value, ccSel.value);
      // Solo las respuestas que corresponden (lead.ts → cleanAnswers, igual que las funciones)
      const a = cleanAnswers(flow());
      const nombre = value("nombre").replace(/\s+/g, " ");
      const eventId = newEventId();
      const spam = value("hr_k9") !== "";
      const test = isTestMode();
      const silent = test || spam;
      const body = {
        tipo: a.tipo ?? "",
        terreno: a.terreno ?? "",
        provincia: a.provincia ?? "",
        partido: a.partido ?? "",
        direccion: a.direccion ?? "",
        m2: a.m2 ?? "",
        etapas: a.etapas ?? "",
        cuando: a.cuando ?? "",
        decide: a.decide ?? "",
        nombre,
        email: value("email").toLowerCase(),
        pais_codigo: phone.cc || "otro",
        whatsapp_num: phone.cc ? phone.num : `+${phone.num}`,
        hr_k9: value("hr_k9"),
        modelo: modelo.value,
        event_id: eventId,
        ...getAttribution(),
        event_source_url: location.href.split("#")[0],
        consent: !consentDenied(),
        // La función puede estar en otro dominio (no recibe las cookies): van en el cuerpo
        fbp: getFbp(),
        fbc: getFbc(),
        prueba: test,
        ts: sentAt,
        // aceptó "Al enviar, aceptás que te contactemos por WhatsApp" (ts = cuándo)
        consentimiento_whatsapp: true,
      };

      // 1) Pantalla siguiente (solo visual): "Calculando…" → precio → agenda (con lote) o redes (sin lote).
      const wa = done.querySelector<HTMLAnchorElement>("[data-wa]")!;
      wa.href = waLink(copy.success.waMessage.replace("{nombre}", () => nombre)) || "#";
      const [firstName, ...lastName] = nombre.split(" ");
      const calUrl = calendarLink({
        first_name: firstName,
        last_name: lastName.join(" "),
        full_name: nombre,
        email: body.email,
        phone: phone.cc ? `+${phone.cc}${phone.num}` : `+${phone.num}`,
      });
      const land = qualifies(a);
      const partner = done.querySelector<HTMLElement>("[data-partner]")!;
      const partnerText = copy.agenda.partner[a.decide ?? ""];
      partner.textContent = partnerText ?? "";
      partner.hidden = !partnerText;
      form.hidden = true;
      showQuoteFlow(a, silent, land);
      if (land) setupBooking(calUrl, body, silent, test);
      if (spam) return; // honeypot: se ve igual, pero no se guarda ni se mide nada

      // ClickWhatsApp (link de respaldo de la agenda): una vez por sesión, nunca en modo prueba
      wa.addEventListener("click", () => {
        trackOnce("wa", "ClickWhatsApp");
        runBackups();
      });

      // 2) Pixel: mismo event_id que la API de conversiones → Meta deduplica (tracking.ts no manda nada en
      // modo prueba). Con lote: Lead (+ LeadCaliente si no es "solo un plano para el albañil").
      // Sin lote: LeadSinTerreno (no cuenta como lead).
      if (land) {
        track("Lead", eventId);
        if (isHot(a)) trackCustom("LeadCaliente", `${eventId}-hot`);
      } else trackCustom("LeadSinTerreno", eventId);

      // 3) submit-lead (Sheets + API de conversiones) y ghl-lead (GHL), mismo cuerpo, ya mismo y en segundo plano
      sendBoth(JSON.stringify(body));
    }

    // ---------- Arranque ----------
    // ?cta=… solo va a "Botón de origen": nunca preselecciona una respuesta.
    const q = new URLSearchParams(location.search);
    setModelo(q.get("cta"));
    // el navegador puede restaurar respuestas al volver con "Atrás": se empieza de cero
    form.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => (r.checked = false));
    form.querySelectorAll<HTMLSelectElement>(".lf-select").forEach((sel) => (sel.selectedIndex = 0));
    // Si ya había avanzado en esta sesión, sigue donde quedó; si no, arranca en la primera pantalla
    if (!restoreState()) {
      show(all[0], false);
      callIntro.hidden = false;
      form.hidden = true;
    }
    stateLocked = false;
    callIntro.querySelector("[data-call-go]")!.addEventListener("click", () => show(all[0]));
    // Llegó con /#cotiza (desde el blog u otra página): abre el formulario
    if (location.hash === "#cotiza") openForm();
  }
</script>
