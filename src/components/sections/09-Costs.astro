---
/**
 * "¿Hay que pagar algo más?": la celda de transparencia. Es el miedo nº 1 del cliente: la respuesta va grande
 * y con el degradé ladrillo, no escondida. Al lado, lo que se paga aparte (solo con plano municipal). Abajo,
 * cómo se pagan los honorarios (barra de hitos del proyecto completo) y los medios de pago.
 * Los honorarios por m² NO van acá: el precio lo da la calculadora del formulario.
 * Textos: landing.ts → costs · planes y medios de pago: site.ts.
 */
import HeadRow from "../grid/HeadRow.astro";
import EndRow from "../grid/EndRow.astro";
import Icon from "../illustrations/Icon.astro";
import { costs as t } from "../../content/landing";
import { site } from "../../data/site";

const plan = site.paymentPlans[t.feesPlan];
const planTitle = t.plans.find((p) => p.key === t.feesPlan)?.title ?? "";
---

<section class="costs" id="lo-que-pagas" aria-labelledby="costos-title">
  <HeadRow label={t.label} title={t.h2} id="costos-title" />
  <div class="g">
    <div class="cell s-4 st-6 cell--glow costs__answer reveal" style="--glow-at:0% 100%;--glow-size:100% 120%;--glow-a:.45">
      <p class="cell__label cell__label--sq etiqueta">{t.extraTag}</p>
      <p class="costs__big">{t.answer}</p>
      <p class="costs__detail">{t.answerDetail}</p>
    </div>
    <div class="cell s-2 st-6 costs__extra reveal">
      <p class="cell__label etiqueta">{t.extraTitle}</p>
      <ul class="costs__list">
        {
          t.extraList.map((c) => (
            <li>
              <Icon name="receipt" size={20} />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="g">
    <div class="cell s-4 st-6 cell--alt costs__fees reveal">
      <p class="cell__label etiqueta">{t.feesTag} · {planTitle}</p>
      <h3 class="t-h3">{t.plansTitle}</h3>
      <ol class="costs__bar" aria-label={`${t.feesTag}: ${planTitle}`}>
        {
          plan.map((s) => (
            <li style={`flex:${s.pct}`}>
              <span class="costs__pct">{s.pct} %</span>
              <span class="costs__when">{s.when}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="cell s-2 st-6 cell--alt reveal">
      <p class="cell__label etiqueta">{t.paymentsTitle}</p>
      <ul class="costs__pay">
        {site.payments.map((m) => <li class="dato">{m}</li>)}
      </ul>
    </div>
  </div>
  <EndRow label={t.cta} cta="costos" note={t.note} />
</section>

<style>
  .costs__answer {
    gap: var(--space-4);
    min-height: 18rem;
  }
  .costs__answer .cell__label {
    color: var(--tinta);
  }
  .costs__big {
    margin-top: auto;
    font-family: var(--f-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    line-height: 1.18;
    text-wrap: balance;
  }
  .costs__detail {
    max-width: 52ch;
    font-size: var(--fs-body-lg);
    color: var(--tinta);
  }
  .costs__list {
    list-style: none;
    display: grid;
    gap: var(--gap);
    margin: 0 calc(var(--cell-pad) * -1) calc(var(--cell-pad) * -1);
    background: var(--linea);
    border-top: var(--gap) solid var(--linea);
  }
  .costs__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem var(--cell-pad);
    background: var(--fondo);
  }
  .costs__list .ico {
    color: var(--ladrillo-texto);
  }
  .costs__extra {
    justify-content: space-between;
  }
  .costs__bar {
    list-style: none;
    display: flex;
    gap: var(--gap);
    margin-top: var(--space-2);
  }
  .costs__bar li {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    padding-top: 0.75rem;
    border-top: 4px solid var(--c-ladrillo);
  }
  .costs__bar li:nth-child(2n) {
    border-top-color: var(--c-ladrillo-hover);
  }
  .costs__pct {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--ladrillo-texto);
  }
  .costs__when {
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--tinta-2);
  }
  .costs__pay {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  @media (max-width: 767px) {
    .costs__bar {
      flex-direction: column;
    }
    .costs__bar li {
      flex: none !important;
      grid-template-columns: 3.5rem 1fr;
      align-items: baseline;
      border-top: 0;
      border-left: 4px solid var(--c-ladrillo);
      padding: 0.25rem 0 0.25rem 0.75rem;
    }
  }
</style>
