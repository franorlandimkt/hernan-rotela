---
/**
 * Hero en celdas (arriba del pliegue en 1280×720 y en 390×844).
 *  Desktop: a la izquierda (3 columnas), la celda del titular (único H1, cota, bajada) con el degradé ladrillo,
 *  la celda CTA ladrillo y la línea en mono. A la derecha (3 columnas), la celda del video (VSL horizontal,
 *  Vsl.astro) sobre la grilla de plano, con un resplandor ladrillo detrás.
 *  Celular: titular → video → celda CTA → línea (el botón entra en la primera pantalla).
 *  La cota es la única de la pantalla. Nada depende del evento `load`.
 */
import Marked from "../ui/Marked.astro";
import Vsl from "../ui/Vsl.astro";
import CtaCell from "../grid/CtaCell.astro";
import { hero as t } from "../../content/landing";
---

<section class="hero g" id="inicio" aria-labelledby="hero-title">
  <div class="cell cell--glow hero__text" style="--glow-at:0% 100%;--glow-size:110% 90%;--glow-a:.42">
    <p class="cell__label cell__label--sq etiqueta hero__label">{t.label}</p>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title"><Marked text={t.h1} /></h1>
      <span class="cota reveal-cota hero__cota" aria-hidden="true"></span>
      <p class="t-body-lg hero__sub">{t.sub}</p>
    </div>
  </div>

  <div class="cell cell--grid hero__video">
    <p class="cell__label etiqueta hero__vtag">{t.videoTag}</p>
    <div class="hero__vsl">
      <Vsl />
    </div>
  </div>

  <CtaCell label={t.ctaPrimary} cta="hero" size="lg" reveal={false} class="hero__cta" />

  <div class="cell cell--alt hero__line">
    <p class="etiqueta">{t.ctaLine}</p>
  </div>
</section>

<style>
  .hero {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "text" "video" "cta" "line";
  }
  .hero > * {
    grid-column: auto;
  }
  .hero__text {
    grid-area: text;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .hero__label {
    color: var(--tinta);
  }
  .hero__copy {
    display: grid;
    gap: var(--space-3);
  }
  .hero__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    font-size: clamp(2.125rem, 1.4rem + 3vw, 4rem);
    line-height: var(--lh-display);
    letter-spacing: -0.015em;
  }
  .hero__cota {
    --cota-w: min(100%, 16rem);
  }
  .hero__sub {
    max-width: 40rem;
    color: var(--tinta-2);
  }
  .hero__video {
    grid-area: video;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--cell-pad);
  }
  /* resplandor ladrillo detrás del video */
  .hero__video::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 55% at 50% 55%, rgb(214 58 31 / 0.3), transparent 72%);
    pointer-events: none;
  }
  .hero__vtag {
    position: relative;
  }
  .hero__vsl {
    width: 100%;
    margin-inline: auto;
    padding: 10px; /* lugar para las marcas de corte del video */
  }
  .hero > :global(.hero__cta) {
    grid-area: cta;
  }
  .hero__line {
    grid-area: line;
    padding-block: 0.875rem;
    justify-content: center;
  }
  @media (max-width: 767px) {
    .hero__vtag {
      display: none;
    }
    .hero__video {
      padding: 0.75rem;
    }
    .hero__vsl {
      padding: 6px;
    }
    .hero__sub {
      font-size: 1.0625rem;
    }
  }
  /* Celulares bajos (iPhone SE, 375×667): el botón tiene que entrar en la primera pantalla */
  @media (max-width: 767px) and (max-height: 720px) {
    .hero__label {
      display: none;
    }
    .hero__title {
      font-size: 1.875rem;
    }
    .hero__text {
      gap: var(--space-3);
      padding-block: 1rem;
    }
    .hero__copy {
      gap: 0.75rem;
    }
    .hero__sub {
      line-height: 1.45;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 1fr auto auto;
      grid-template-areas: "text video" "cta video" "line video";
      /* todo el hero entra en la primera pantalla */
      min-height: calc(100svh - var(--bar-top) - var(--bar-bottom) - var(--gap) * 4);
    }
    .hero__title {
      font-size: clamp(2.5rem, min(4.3vw, 7.6svh), 5.5rem);
    }
    .hero > :global(.hero__cta) {
      min-height: 4.5rem;
    }
    .hero__vsl {
      /* el video se achica con el alto de la pantalla para que entre */
      max-width: min(100%, calc((100svh - var(--bar-top) - var(--bar-bottom) - 9rem) * 16 / 9));
    }
  }
</style>
