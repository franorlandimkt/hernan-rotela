---
/**
 * Íconos de trazo HABITAR: 1,5 px (no escala con el tamaño), esquinas rectas (linecap square, linejoin
 * miter), sin rellenos. `.acc` = trazo en ladrillo (un detalle por ícono, como la cota del logo).
 * Uso: <Icon name="plan" size={24} />. Para agregar uno: sumá una entrada a `icons` (viewBox 24×24).
 * Nunca emojis en la web (manual, sección 6).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
}
const { name, size = 24, class: cls = "", title } = Astro.props;

const icons: Record<string, string> = {
