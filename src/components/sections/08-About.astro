---
/**
 * Quién soy en celdas: la historia en primera persona, versión corta y grande (3 columnas) + la foto de
 * Hernán (src/assets/img/hernan.*; sin foto, la placa con el isotipo; en `npm run dev`, el nombre del archivo)
 * + "Siempre estoy construyéndome." en display, con el degradé ladrillo. Textos: landing.ts → about.
 */
import HeadRow from "../grid/HeadRow.astro";
import EndRow from "../grid/EndRow.astro";
import Img from "../ui/Img.astro";
import { about as t } from "../../content/landing";
import { site } from "../../data/site";
import { hasImg, DEV } from "../../lib/images";

const photo = hasImg(t.photo);
---

<section class="about" id="quien-soy" aria-labelledby="quien-soy-title">
  <HeadRow label={t.label} title={t.h2} id="quien-soy-title" />
  <div class="g">
    <div class="cell s-3 st-6 about__story reveal">
      {t.story.map((p) => <p class="t-big">{p}</p>)}
    </div>
    <figure class="cell cell--flush s-1 st-2 about__photo reveal">
      {
        photo ? (
          <Img name={t.photo} alt={t.photoAlt} widths={[320, 640, 960]} sizes="(min-width: 1024px) 16vw, (min-width: 768px) 33vw, 100vw" aspect="4/5" class="about__img" />
        ) : DEV ? (
          <p class="slot-dev about__dev">{t.photoPending}</p>
        ) : (
          <div class="about__plate cell--grid">
            <img src={site.logo.isoInverse} alt="" width="80" height="64" loading="lazy" decoding="async" />
          </div>
        )
      }
      <figcaption class="etiqueta about__tag">{t.photoTag}</figcaption>
    </figure>
    <div class="cell s-2 st-4 cell--glow cell--split about__motto reveal" style="--glow-at:100% 100%;--glow-size:120% 110%;--glow-a:.5">
      <p class="cell__label etiqueta">{t.quoteTag}</p>
      <p class="about__quote">{t.quote}</p>
    </div>
  </div>
  <EndRow label={t.cta} cta="quien-soy" note={t.note} />
</section>

<style>
  .about__story {
    gap: var(--space-4);
  }
  .about__story p + p {
    color: var(--tinta-2);
  }
  .about__photo {
    margin: 0;
    min-height: 16rem;
  }
  .about__photo :global(.lb-trigger),
  .about__photo :global(picture),
  .about__photo :global(.about__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__plate,
  .about__dev {
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 16rem;
  }
  .about__plate {
    background-color: var(--superficie);
  }
  .about__tag {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgb(22 22 22 / 0.82);
    color: var(--tinta);
    font-size: 0.6875rem;
  }
  .about__motto {
    gap: var(--space-5);
    container-type: inline-size;
  }
  .about__quote {
    font-family: var(--f-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    font-size: min(3.5rem, 10.5cqi); /* "construyéndome" entra entera en la celda */
    line-height: var(--lh-display);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
</style>
