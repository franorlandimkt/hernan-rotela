---
/**
 * Proyectos: fichas con rótulo de carátula (obra, ubicación, superficie, estado), solo de Hernán.
 * Renders y planos: solo si están en landing.ts → projects.items[].images (abren el lightbox; "Quiero algo
 * así" abre el formulario). Carátulas de planos aprobados: solo si hay imágenes. El caso de las 3 unidades,
 * sin nombre. Nunca "obras terminadas": no hay obra 100 % terminada proyectada por él.
 */
import SectionHead from "../ui/SectionHead.astro";
import CtaBlock from "../ui/CtaBlock.astro";
import Rotulo from "../ui/Rotulo.astro";
import Img from "../ui/Img.astro";
import { projects as t } from "../../content/landing";
---

<section class="section s-hueso projects" id="proyectos" aria-labelledby="proyectos-title">
  <div class="container">
    <SectionHead label={t.label} title={t.h2} sub={t.sub} id="proyectos-title" />
    <ul class="projects__grid">
      {
        t.items.map((p, i) => (
          <li class="projects__item reveal" style={`--delay:${i * 0.06}s`}>
            {p.images.length > 0 && (
              <div class="projects__imgs">
                {p.images.map((im, j) => (
                  <Img name={im.name} alt={im.alt} lightbox="proyectos" widths={[480, 800]} sizes="(min-width: 1024px) 40vw, 100vw" aspect={j === 0 ? "4/3" : "1/1"} class="projects__img" />
                ))}
              </div>
            )}
            <h3 class="t-h3 projects__title">
              {p.title} · {p.m2}
            </h3>
            <Rotulo
              items={[
                [t.sheetKeys.obra, p.title],
                [t.sheetKeys.place, p.place],
                [t.sheetKeys.m2, p.m2],
                [t.sheetKeys.status, p.status],
              ]}
              label={`${p.title} en ${p.place}`}
            />
            {p.note && <p class="projects__note t-small">{p.note}</p>}
          </li>
        ))
      }
    </ul>

    {
      t.approved.images.length > 0 && (
        <div class="projects__approved">
          <h3 class="t-h3">{t.approved.title}</h3>
          <p>{t.approved.text}</p>
          <div class="projects__strip">
            {t.approved.images.map((im) => (
              <Img name={im.name} alt={im.alt} lightbox="aprobados" widths={[400, 800]} sizes="(min-width: 1024px) 20vw, 50vw" class="projects__img" />
            ))}
          </div>
        </div>
      )
    }

    <aside class="projects__story reveal">
      <span class="etiqueta">{t.story.tag}</span>
      <h3 class="t-h2">{t.story.title}</h3>
      <p>{t.story.text}</p>
    </aside>
    <CtaBlock label={t.cta} cta="proyectos" />
  </div>
</section>

<style>
  .projects__grid {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }
  .projects__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .projects__imgs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }
  .projects__imgs > :first-child {
    grid-column: 1 / -1;
  }
  .projects__imgs :global(img),
  .projects__strip :global(img) {
    width: 100%;
    border-radius: var(--radius-md);
  }
  .projects__note {
    color: var(--tinta-2);
  }
  .projects__approved {
    margin-top: var(--space-5);
  }
  .projects__approved p {
    color: var(--tinta-2);
    margin-top: var(--space-2);
  }
  .projects__strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .projects__story {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--superficie);
    border-left: 2px solid var(--c-ladrillo);
    max-width: 44rem;
  }
  .projects__story .t-h2 {
    margin-block: var(--space-2) var(--space-3);
  }
  .projects__story p {
    color: var(--tinta-2);
  }
  @media (min-width: 768px) {
    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }
  }
</style>
