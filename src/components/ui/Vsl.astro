---
/**
 * Video de Hernán (VSL) del hero: HORIZONTAL 16:9, centrado.
 *  - Sin video todavía (site.video.src vacío): se ve el póster [PLACEHOLDER] y el play no hace nada.
 *  - NO se reproduce solo: quieto con el póster hasta que la persona toca el play. Ahí carga el archivo
 *    (antes no baja nada) y arranca con sonido y con los controles del navegador.
 *  - Si sigue bajando mientras suena (el del hero salió de pantalla), el MISMO video queda chico abajo a la
 *    derecha: nunca se ven dos. Va encima de la barra de abajo (--bar-h) y del aviso de cookies (--cookie-h),
 *    con una X para cerrarlo y una flecha para volver al hero. Al volver arriba, vuelve a su lugar.
 *  - Mientras el formulario está abierto (pop-up de 13-Form.astro) se pausa y vuelve a su lugar
 *    (eventos hr:form-open / hr:form-close).
 *  - Nada depende del evento `load` (el Pixel en el <head> lo puede demorar).
 * Archivo y póster: site.ts → video · Textos: landing.ts → hero.video.
 */
import Icon from "../illustrations/Icon.astro";
import { hero } from "../../content/landing";
import { site } from "../../data/site";

const v = site.video;
const t = hero.video;
const has = !!v.src;
---

<div class:list={["vsl", { "vsl--pending": !has }]} data-vsl>
  <!-- .vsl__stage guarda el lugar 16:9 en la página; .vsl__frame es lo que se achica a la esquina -->
  <div class="vsl__stage ticks">
    <div class="vsl__frame" data-vsl-frame>
      <video class="vsl__video" playsinline preload="none" poster={v.poster} data-src={v.src} width={v.width} height={v.height} aria-label={t.label}></video>
      <button type="button" class="vsl__play" data-vsl-play aria-label={has ? t.play : t.pending} disabled={!has}>
        <span class="vsl__play-ico" aria-hidden="true"><Icon name="play-solid" size={30} /></span>
        <span class="vsl__cue etiqueta">{has ? t.cue : t.pending}</span>
      </button>
      <button type="button" class="vsl__mini vsl__back" data-vsl-back aria-label={t.back} hidden>
        <Icon name="expand" size={16} />
      </button>
      <button type="button" class="vsl__mini vsl__close" data-vsl-close aria-label={t.close} hidden>
        <Icon name="x" size={16} />
      </button>
    </div>
  </div>
</div>

<style>
  .vsl {
    width: 100%;
  }
  .vsl__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    --tick-off: 9px;
    --tick-len: 18px;
  }
  @supports not (aspect-ratio: 1) {
    .vsl__stage {
      height: 0;
      padding-bottom: 56.25%;
    }
  }
  .vsl__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1.5px solid var(--c-hueso);
    border-radius: var(--radius-md);
    background: #1d1c1b;
  }
  .vsl__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #1d1c1b;
  }
  /* Play: todo el video es el botón hasta que arranca */
  .vsl__play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 0;
    background: linear-gradient(to top, rgb(22 22 22 / 0.55), rgb(22 22 22 / 0.05) 55%);
    color: var(--c-hueso);
    -webkit-tap-highlight-color: transparent;
  }
  .vsl__play[disabled] {
    cursor: default;
  }
  .vsl__play-ico {
    display: grid;
    place-items: center;
    width: clamp(3.75rem, 2.9rem + 3.6vw, 5.5rem);
    height: clamp(3.75rem, 2.9rem + 3.6vw, 5.5rem);
    border-radius: var(--radius-md);
    background: var(--c-ladrillo);
    color: var(--c-white);
    transition:
      transform 0.2s var(--ease),
      background-color 0.18s;
  }
  .vsl__play-ico :global(.ico) {
    transform: translateX(2px);
  }
  .vsl__play:not([disabled]):hover .vsl__play-ico {
    background: var(--c-ladrillo-hover);
    transform: scale(1.05);
  }
  .vsl__cue {
    color: var(--c-hueso);
    text-align: center;
  }
  .vsl--pending .vsl__play-ico {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--c-hueso);
    color: var(--c-hueso);
  }
  .vsl.is-started .vsl__play {
    display: none;
  }

  /* Botones chicos (solo cuando está en la esquina) */
  .vsl__mini {
    position: absolute;
    top: 0.375rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: rgb(22 22 22 / 0.78);
    color: var(--c-hueso);
  }
  .vsl__close {
    right: 0.375rem;
  }
  .vsl__back {
    left: 0.375rem;
  }

  /* En la esquina (la persona siguió bajando con el video sonando) */
  .vsl.is-docked .vsl__frame {
    position: fixed;
    inset: auto 0.75rem calc(0.75rem + var(--cookie-h, 0px) + var(--bar-h, 0px)) auto;
    z-index: 48;
    width: min(62vw, 15rem);
    aspect-ratio: 16 / 9;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px rgb(22 22 22 / 0.35);
  }
  @media (min-width: 768px) {
    .vsl.is-docked .vsl__frame {
      inset: auto calc(var(--rail-x, 0px) + 1.5rem) calc(1rem + var(--cookie-h, 0px) + var(--bar-h, 0px)) auto;
      width: 22rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .vsl.is-docked .vsl__frame {
      animation: vsl-in 0.3s var(--ease);
    }
  }
  @keyframes vsl-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-vsl]");
  if (root) {
    const stage = root.querySelector<HTMLElement>(".vsl__stage")!;
    const video = root.querySelector<HTMLVideoElement>("video")!;
    const play = root.querySelector<HTMLButtonElement>("[data-vsl-play]")!;
    const close = root.querySelector<HTMLButtonElement>("[data-vsl-close]")!;
    const back = root.querySelector<HTMLButtonElement>("[data-vsl-back]")!;
    let started = false;
    let dismissed = false; // cerró el video chico: no vuelve a la esquina hasta que le dé play otra vez
    let outOfView = false;

    const dock = (on: boolean) => {
      root.classList.toggle("is-docked", on);
      close.hidden = back.hidden = !on;
    };
    const sync = () => dock(started && outOfView && !dismissed && !video.paused && !document.documentElement.classList.contains("lf-open"));

    play.addEventListener("click", () => {
      const src = video.dataset.src;
      if (!src) return;
      if (!started) {
        video.src = src;
        video.controls = true;
        started = true;
        root.classList.add("is-started");
      }
      video.muted = false;
      video.play().catch(() => {
        // el navegador no dejó arrancar con sonido: quedan los controles a la vista
      });
    });
    video.addEventListener("play", () => {
      dismissed = false;
      sync();
    });
    video.addEventListener("ended", () => dock(false));

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([e]) => {
          outOfView = !e.isIntersecting;
          sync();
        },
        { threshold: 0.25 },
      ).observe(stage);
    }

    close.addEventListener("click", () => {
      dismissed = true;
      video.pause();
      dock(false);
    });
    back.addEventListener("click", () => stage.scrollIntoView({ block: "center", behavior: "smooth" }));

    // Formulario en pop-up: el video se pausa y vuelve a su lugar
    document.addEventListener("hr:form-open", () => {
      if (!video.paused) video.pause();
      dock(false);
    });
  }
</script>
