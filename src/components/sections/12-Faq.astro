---
/** Preguntas frecuentes con <details>/<summary> (abren al primer toque). El mismo texto alimenta el JSON-LD FAQPage. */
import SectionHead from "../ui/SectionHead.astro";
import CtaBlock from "../ui/CtaBlock.astro";
import { faq } from "../../content/landing";
---

<section class="section s-hueso faq" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq__in">
    <SectionHead label={faq.label} title={faq.h2} id="faq-title" />
    <div class="faq__list">
      {
        faq.items.map((f) => (
          <details class="faq__item">
            <summary>
              <h3 class="faq__q">{f.q}</h3>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <div class="container">
    <CtaBlock label={faq.cta} cta="faq" />
  </div>
</section>

<style>
  .faq__in {
    display: grid;
    gap: var(--space-3);
  }
  .faq__list {
    border-top: 1px solid var(--tinta);
  }
  .faq__item {
    border-bottom: 1px solid var(--linea);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font-family: var(--f-body);
    font-size: var(--fs-body-lg);
    font-weight: 600;
    line-height: 1.35;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 1.5px;
    background: var(--tinta);
    transform: translate(-50%, -50%);
    transition: transform 0.2s var(--ease);
  }
  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
    background: var(--c-ladrillo);
  }
  .faq__a {
    padding: 0 2.5rem var(--space-4) 0;
    color: var(--tinta-2);
    max-width: var(--measure);
  }
  @media (min-width: 1024px) {
    .faq__in {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-6);
      align-items: start;
    }
  }
</style>
