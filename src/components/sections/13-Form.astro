    // Si escribió (o el autocompletado puso) un teléfono en el nombre: aviso y, si es un WhatsApp válido y el
    // campo de WhatsApp está vacío, pasa solo ahí. Si el WhatsApp ya tiene otro número, no se borra nada.
    function checkName() {
      const d = nameDigits();
      if (!d) return;
      if (d >= NAME_PHONE_DIGITS) {
        const asPhone = nameIn.value.replace(/[^\d+().\s-]/g, "").trim();
        const p = readPhone(asPhone, ccSel.value);
        if (p.ok) {
          const current = tel.value.trim() ? readPhone(tel.value, ccSel.value) : null;
          if (!current) {
            tel.value = asPhone;
            normalizePhone();
            fieldError(tel, "");
          }
          if (!current || (current.cc === p.cc && current.num === p.num)) {
            // se va solo el número ("Juan 11 2345 6789" → "Juan")
            nameIn.value = nameIn.value.replace(/\+?\(?\d[\d\s().-]*\d\)?/g, " ").replace(/\s+/g, " ").trim();
            nameWasPhone = true;
