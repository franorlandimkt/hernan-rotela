---
/**
 * Hero (grafito, todo centrado): etiqueta (nombre + título), único H1, bajada, el video de Hernán
 * (horizontal, Vsl.astro), el botón al formulario con su línea de respaldo, tres datos y la línea de planos a
 * distancia. En el celular el orden es el mismo: título → video → botón (el botón queda a la vista en la
 * primera pantalla o apenas se baja). La cota en ladrillo "mide" el ancho del video: es la única de la pantalla.
 */
import Marked from "../ui/Marked.astro";
import Vsl from "../ui/Vsl.astro";
import Icon from "../illustrations/Icon.astro";
import { hero as t } from "../../content/landing";
---

<section class="hero s-grafito s-grid" aria-labelledby="hero-title">
  <div class="container hero__in">
    <p class="etiqueta hero__label"><span class="hero__dot" aria-hidden="true"></span>{t.label}</p>
    <h1 id="hero-title" class="hero__title"><Marked text={t.h1} /></h1>
    <p class="t-body-lg hero__sub">{t.sub}</p>

    <div class="hero__video">
      <Vsl />
      <span class="cota reveal-cota hero__cota" aria-hidden="true"></span>
    </div>

    <div class="hero__ctas">
      <a class="btn btn--lg hero__btn" href="#cotiza" data-cta="hero">
        {t.ctaPrimary}
        <Icon name="arrow-right" size={20} class="arrow" />
      </a>
      <ul class="hero__notes etiqueta">
        {t.ctaNotes.map((n) => <li>{n}</li>)}
      </ul>
    </div>

    <dl class="hero__stats">
      {
        t.stats.map((s) => (
          <div>
            <dt class="etiqueta">{s.label}</dt>
            <dd class="num">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="hero__remote t-small">
      {t.remote} <a class="link" href="#a-distancia">{t.remoteLink}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 0.8rem + 3vw, 3.5rem) clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
    color: var(--tinta);
    overflow: hidden;
  }
  .hero__in {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__label {
    max-width: 22rem;
    color: var(--tinta);
  }
  .hero__dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.625rem;
    background: var(--c-ladrillo);
  }
  .hero__title {
    margin-top: var(--space-3);
    max-width: 20ch;
    font-family: var(--f-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    font-size: var(--fs-hero);
    line-height: 1.06;
    letter-spacing: -0.012em;
  }
  /* En el hero el acento va en ladrillo puro: el título es grande (≥30 px, peso 800) y sobre grafito da 3,9:1 */
  .hero__title :global(.mark) {
    color: var(--c-ladrillo);
  }
  .hero__sub {
    margin-top: var(--space-3);
    max-width: 40rem;
    color: var(--tinta-2);
  }
  /* El video se achica con el alto de la pantalla (desktop): el botón queda en la primera pantalla */
  .hero__video {
    width: 100%;
    max-width: min(54rem, max(22rem, calc((100svh - 29rem) * 16 / 9)));
    margin-top: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
  }
  .hero__cota {
    margin-top: 1.125rem;
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    width: 100%;
  }
  .hero__btn {
    min-height: 3.75rem;
    padding-inline: 2.25rem;
    font-size: 1.125rem;
  }
  .hero__notes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0;
    color: var(--tinta-2);
    font-size: 0.75rem;
  }
  .hero__notes li + li::before {
    content: "·";
    margin-inline: 0.625rem;
    color: var(--ladrillo-texto);
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 54rem;
    margin: clamp(2rem, 1.5rem + 2vw, 3.25rem) 0 0;
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
  }
  .hero__stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
    padding: var(--space-3) 0.5rem;
  }
  .hero__stats > div + div {
    border-left: 1px solid var(--linea);
  }
  .hero__stats dd {
    margin: 0;
  }
  .hero__stats dt {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--tinta-2);
  }
  .hero__remote {
    margin-top: var(--space-4);
    color: var(--tinta-2);
  }
  @media (max-width: 479px) {
    .hero__btn {
      width: 100%;
    }
    .hero__notes {
      flex-direction: column;
      gap: 0.25rem;
    }
    .hero__notes li + li::before {
      content: none;
    }
    .hero__stats .num {
      font-size: 1.25rem;
      white-space: nowrap;
    }
    .hero__stats dt {
      font-size: 0.625rem;
      letter-spacing: 0.06em;
    }
  }
  @media (min-width: 768px) {
    .hero__label {
      max-width: none;
    }
    .hero__stats > div {
      padding: var(--space-4) var(--space-3);
    }
    .hero__stats dt {
      font-size: var(--fs-etiqueta);
    }
  }
  /* Desktop: título en dos renglones y bajada en uno, para que el video y el botón entren en la primera pantalla */
  @media (min-width: 1100px) {
    .hero__title {
      max-width: 62rem;
      font-size: 3rem;
    }
    .hero__sub {
      max-width: 56rem;
    }
    /* la frase en ladrillo no se parte: baja entera al segundo renglón */
    .hero__title :global(.mark) {
      display: inline-block;
    }
  }
</style>
