    // ---------- Envío del lead (en segundo plano, con reintentos y respaldo) ----------
    const PENDING_KEY = "hr_lead_pendiente";
    const GHL_PENDING_KEY = "hr_ghl_pendiente";
    /** Un intento. "ok": la función confirmó · "invalid": la función lo rechazó (4xx, no se reintenta) ·
     *  "fail": red, tiempo, Sheets o GHL (se reintenta). */
    async function postOnce(payload: string, timeout: number, endpoint: string): Promise<"ok" | "invalid" | "fail"> {
      try {
        const req = fetch(endpoint, {
          method: "POST",
          keepalive: true, // sigue aunque la página se vaya (agenda, WhatsApp, cerrar la pestaña)
          headers: { "Content-Type": "text/plain;charset=UTF-8" }, // pedido "simple": sin preflight CORS
          body: payload,
        })
          .then(async (r) => {
            if (r.status >= 400 && r.status < 500) return "invalid" as const;
            return (r.ok && (await r.json().catch(() => null))?.ok ? "ok" : "fail") as "ok" | "fail";
          })
          .catch(() => "fail" as const);
        return await Promise.race([req, new Promise<"fail">((r) => setTimeout(() => r("fail"), timeout))]);
      } catch {
        return "fail";
      }
    }
    /** Hasta ATTEMPTS intentos con espera corta, dentro de `budget` ms. Sheets no duplica el event_id. */
    async function sendLead(payload: string, budget: number, endpoint: string): Promise<"ok" | "invalid" | "fail"> {
      const t0 = Date.now();
      for (let i = 0; i < ATTEMPTS; i++) {
        const left = budget - (Date.now() - t0);
        if (left < 500) break;
        const r = await postOnce(payload, Math.min(left, 10000), endpoint);
        if (r !== "fail") return r;
        await new Promise((res) => setTimeout(res, 600 * (i + 1)));
      }
      return "fail";
    }
    function beacon(payload: string, endpoint: string) {
      try {
        return !!navigator.sendBeacon?.(endpoint, new Blob([payload], { type: "text/plain;charset=UTF-8" }));
      } catch {
        return false;
      }
    }
    function savePending(payload: string, key: string) {
      try {
        localStorage.setItem(key, payload);
      } catch {}
    }
    function clearPending(key: string) {
      try {
        localStorage.removeItem(key);
      } catch {}
    }
    // Lead que no se confirmó en una visita anterior: se reenvía (mismo event_id → ni Sheets ni Meta duplican).
    // Si la función lo rechaza (400) se descarta. Lo mismo con GHL, por separado.
    (
      [
        [PENDING_KEY, endpoints.lead],
        [GHL_PENDING_KEY, endpoints.ghl],
      ] as const
    ).forEach(async ([key, endpoint]) => {
      let pending: string | null = null;
      try {
        pending = localStorage.getItem(key);
      } catch {}
      if (pending && (await sendLead(pending, 15000, endpoint)) !== "fail") clearPending(key);
    });
    /**
     * Manda el mismo cuerpo a una función con keepalive y reintentos; queda pendiente en el teléfono hasta que
     * confirma. Si la persona se va antes (agenda, WhatsApp, cierra, cambia de app): sendBeacon.
     */
    function sendBoth(payload: string) {
      for (const [key, endpoint] of [
        [PENDING_KEY, endpoints.lead],
        [GHL_PENDING_KEY, endpoints.ghl],
      ] as const) {
        savePending(payload, key);
        let settled = false;
        let beaconed = false;
        const backup = () => {
          if (settled || beaconed) return;
          beaconed = beacon(payload, endpoint);
        };
