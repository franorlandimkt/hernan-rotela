---
/**
 * Proyectos: fichas solo de Hernán. La superficie va grande (es el dato), el estado real en una pastilla
 * (punto ladrillo = aprobado / en construcción · punto hueco = en trámite) y la ubicación en mono.
 * Renders y planos: se suben a src/assets/img/ como proyecto-<key>-1.jpg, -2.jpg… y aparecen solos (abren el
 * lightbox; "Quiero algo así" abre el formulario). Carátulas de planos aprobados: aprobado-1.jpg, -2.jpg…
 * El caso de las 3 unidades, sin nombre. Nunca "obras terminadas": no hay obra 100 % terminada proyectada por él.
 */
import SectionHead from "../ui/SectionHead.astro";
import CtaBlock from "../ui/CtaBlock.astro";
import Img from "../ui/Img.astro";
import Icon from "../illustrations/Icon.astro";
import { projects as t } from "../../content/landing";
import { imgSeries, DEV } from "../../lib/images";

const items = t.items.map((p) => ({ ...p, images: imgSeries(`proyecto-${p.key}`) }));
const approved = imgSeries("aprobado");
const alt = (tpl: string, v: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));
---

<section class="section s-hueso projects" id="proyectos" aria-labelledby="proyectos-title">
  <div class="container">
    <SectionHead label={t.label} title={t.h2} sub={t.sub} id="proyectos-title" />
    <ul class="projects__grid">
      {
        items.map((p, i) => (
          <li class="projects__item reveal" style={`--delay:${i * 0.06}s`}>
            {p.images.length > 0 && (
              <div class:list={["projects__imgs", { "projects__imgs--one": p.images.length === 1 }]}>
                {p.images.slice(0, 3).map((name, j) => (
                  <Img name={name} alt={alt(t.imageAlt, { titulo: p.title, lugar: p.place, n: j + 1 })} lightbox="proyectos" widths={[480, 800]} sizes="(min-width: 1024px) 40vw, 100vw" aspect={j === 0 ? "16/10" : "4/3"} class="projects__img" />
                ))}
              </div>
            )}
            {p.images.length === 0 && DEV && <p class="slot-dev">Faltan las imágenes: src/assets/img/proyecto-{p.key}-1.jpg, -2.jpg…</p>}
            <div class="projects__body">
              <p class="projects__m2 num">{p.m2}</p>
              <h3 class="t-h3 projects__title">{p.title}</h3>
              <p class="projects__place dato">
                <Icon name="pin" size={16} />
                <span>{p.place}</span>
              </p>
              <p class="pill projects__state">
                <span class:list={["pill__dot", { "pill__dot--off": p.state === "tramite" }]} />
                {p.status}
              </p>
              {p.note && <p class="projects__note t-small">{p.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      approved.length > 0 && (
        <div class="projects__approved reveal">
          <h3 class="t-h3">{t.approved.title}</h3>
          <p>{t.approved.text}</p>
          <div class="projects__strip">
            {approved.map((name, j) => (
              <Img name={name} alt={alt(t.approved.imageAlt, { n: j + 1 })} lightbox="aprobados" widths={[400, 800]} sizes="(min-width: 1024px) 20vw, 50vw" class="projects__img" />
            ))}
          </div>
        </div>
      )
    }
    {approved.length === 0 && DEV && <p class="slot-dev projects__dev">Faltan las carátulas de planos aprobados: src/assets/img/aprobado-1.jpg, aprobado-2.jpg…</p>}

    <aside class="projects__story reveal">
      <span class="pill"><span class="pill__dot"></span>{t.story.tag}</span>
      <div>
        <h3 class="t-h2">{t.story.title}</h3>
        <p>{t.story.text}</p>
      </div>
    </aside>
    <CtaBlock label={t.cta} cta="proyectos" />
  </div>
</section>

<style>
  .projects__grid {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .projects__item {
    display: flex;
    flex-direction: column;
    background: var(--superficie);
    border: 1px solid var(--tinta);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .projects__imgs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    border-bottom: 1px solid var(--tinta);
  }
  .projects__imgs > :first-child {
    grid-column: 1 / -1;
  }
  .projects__imgs :global(img),
  .projects__strip :global(img) {
    width: 100%;
  }
  .projects__item > .slot-dev {
    margin: var(--space-3) var(--space-3) 0;
  }
  .projects__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    height: 100%;
    padding: var(--space-4);
  }
  .projects__m2 {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--c-ladrillo);
  }
  .projects__title {
    margin-top: 0.375rem;
  }
  .projects__place {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--tinta-2);
  }
  .projects__state {
    margin-top: 0.5rem;
    text-align: left;
  }
  .projects__note {
    margin-top: 0.5rem;
    color: var(--tinta-2);
  }
  .projects__approved {
    margin-top: var(--space-5);
  }
  .projects__approved p {
    color: var(--tinta-2);
    margin-top: var(--space-2);
  }
  .projects__strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .projects__strip :global(img) {
    border: 1px solid var(--tinta);
    border-radius: var(--radius-sm);
  }
  .projects__dev {
    margin-top: var(--space-4);
  }
  .projects__story {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--c-grafito);
    color: var(--c-hueso);
    border-radius: var(--radius-md);
  }
  .projects__story .pill {
    align-self: start;
    border-color: var(--c-hueso);
    color: var(--c-hueso);
  }
  .projects__story .t-h2 {
    font-stretch: var(--stretch-display);
  }
  .projects__story p {
    margin-top: var(--space-2);
    color: #b9b4ac;
    max-width: 46rem;
  }
  @media (min-width: 640px) {
    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .projects__story {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-5);
      padding: var(--space-5);
    }
  }
  @media (min-width: 1100px) {
    .projects__grid:not(:has(.projects__imgs)) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
