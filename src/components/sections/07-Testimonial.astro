---
/**
 * Testimonio en celdas: la cita grande (fragmento textual del audio, con la frase marcada) en 4 columnas +
 * la celda del audio (reproductor si hay archivo en public/audio/, la persona y el origen) en 2.
 * Solo testimonios reales. Con publish: false (falta la autorización, [CONFIRMAR]) NO se publica: en
 * `npm run dev` se ve con el borde de pendiente. Sin schema Review hasta tener reseñas públicas verificables.
 * Fotos (src/assets/img/, aparecen solas): <key>.jpg = la persona · testimonio-<key>.jpg = captura del chat.
 */
import HeadRow from "../grid/HeadRow.astro";
import EndRow from "../grid/EndRow.astro";
import Img from "../ui/Img.astro";
import Icon from "../illustrations/Icon.astro";
import { testimonial as t } from "../../content/landing";
import { hasImg, DEV } from "../../lib/images";

const items = t.items
  .filter((i) => i.publish || (DEV && i.quote))
  .map((i) => {
    const q = i.quote || i.text;
    const at = i.mark ? q.indexOf(i.mark) : -1;
    return {
      ...i,
      parts: at < 0 ? [q, "", ""] : [q.slice(0, at), i.mark, q.slice(at + i.mark.length)],
      photo: hasImg(i.key),
      capture: hasImg(`testimonio-${i.key}`),
    };
  });
const pending = items.some((i) => !i.publish);
// barras de la "onda" del audio (decorativas)
const wave = [5, 9, 14, 8, 16, 11, 6, 13, 18, 10, 7, 15, 12, 6, 9, 17, 11, 5, 8, 14, 10, 6, 12, 7];
---

{
  items.length > 0 && (
    <section class:list={["testimonial", { pendiente: pending }]} id="testimonio" aria-labelledby="testimonio-title">
      <HeadRow label={t.label} title={t.h2} id="testimonio-title" />
      {items.map((it) => (
        <figure class="g testimonial__item">
          <div class="cell s-4 st-6 cell--glow testimonial__main reveal" style="--glow-at:0% 0%;--glow-size:80% 110%;--glow-a:.3">
            <span class="testimonial__mark" aria-hidden="true">
              “
            </span>
            <blockquote class="testimonial__quote">
              <p>
                {it.parts[0]}
                {it.parts[1] && <span class="hl">{it.parts[1]}</span>}
                {it.parts[2]}
              </p>
            </blockquote>
          </div>
          <figcaption class="stack s-2 st-6">
            <div class="cell testimonial__who reveal">
              <span class="testimonial__avatar">
                {it.photo ? <Img name={it.key} alt={t.photoAlt.replace("{nombre}", it.name)} widths={[96, 192]} sizes="56px" aspect="1/1" /> : <span aria-hidden="true">{it.name.charAt(0)}</span>}
              </span>
              <span class="testimonial__whotxt">
                <strong class="t-h3">{it.name}</strong>
                <span class="dato">{it.detail}</span>
              </span>
            </div>
            <div class="cell cell--alt testimonial__audio reveal">
              <p class="cell__label etiqueta">
                <Icon name="audio" size={16} />
                {it.source}
              </p>
              {it.audio ? (
                <audio controls preload="none" src={it.audio} aria-label={`${t.audioLabel}: ${it.name}`} />
              ) : (
                <>
                  <span class="testimonial__wave" aria-hidden="true">
                    {wave.map((h) => (
                      <i style={`height:${h}px`} />
                    ))}
                  </span>
                  {DEV && <p class="slot-dev">{t.audioPending}</p>}
                </>
              )}
            </div>
            {it.capture && (
              <div class="cell cell--flush testimonial__capture reveal">
                <Img name={`testimonio-${it.key}`} alt={t.captureAlt.replace("{nombre}", it.name)} lightbox="testimonios" widths={[400, 800]} sizes="(min-width: 1024px) 28vw, 80vw" />
              </div>
            )}
          </figcaption>
        </figure>
      ))}
      <EndRow label={t.cta} cta="testimonio" note={t.note} />
    </section>
  )
}

<style>
  .testimonial__item {
    margin: 0;
  }
  .testimonial__main {
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 18rem;
  }
  .testimonial__mark {
    display: block;
    height: 0.45em;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    line-height: 1;
    color: var(--c-ladrillo);
  }
  .testimonial__quote {
    margin: 0;
  }
  .testimonial__quote p {
    font-family: var(--f-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  .testimonial__who {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }
  .testimonial__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--g-cta);
    color: var(--c-white);
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.5rem;
  }
  .testimonial__whotxt {
    display: grid;
    gap: 0.125rem;
  }
  .testimonial__whotxt .dato {
    color: var(--tinta-2);
  }
  .testimonial__audio {
    flex-grow: 1;
    justify-content: space-between;
  }
  .testimonial__audio audio {
    width: 100%;
  }
  .testimonial__wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 2rem;
  }
  .testimonial__wave i {
    width: 3px;
    background: var(--ladrillo-texto);
    opacity: 0.85;
  }
</style>
