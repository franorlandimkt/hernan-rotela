---
/**
 * Cotizá tu proyecto: formulario multipaso (adaptado del de Víctor, v1.60) con el manual HABITAR: tarjeta
 * en hueso/superficie, texto en tinta, ladrillo solo para el botón, el detalle de la opción elegida, la barra
 * de avance y el precio. Preguntas: src/content/form-steps.ts · Reglas: src/scripts/lead.ts ·
 * Textos: src/content/landing.ts (form).
 *
 * Flujo (script de abajo): primera pantalla ("Cotizá tu proyecto" + "Empezar") → una pregunta por pantalla
 * con ramas (lead.ts → nextStep): partido solo si la provincia es Buenos Aires; dirección de obra solo dentro
 * del radio de 150 km; en etapas, "Proyecto completo con plano municipal" solo dentro del radio.
 * "Paso X de N" se recalcula con cada respuesta (lead.ts → totalSteps).
 *  - "Regularizar o medir algo ya construido" (P1) → descarte: mensaje amable + WhatsApp + redes, sin agenda.
 *    No se envía ni se guarda nada; solo el evento anónimo FormDisqualified { reason: "regularizacion" }.
 *  - "Tus datos" → "¿Este es tu WhatsApp?" → "Sí, es correcto": en el mismo clic, un event_id, Pixel
 *    (Lead + LeadCaliente si califica; LeadSinTerreno sin lote) y envío a submit-lead (Sheets + API de
 *    conversiones) y a ghl-lead (GHL), con keepalive, reintentos, sendBeacon si se va y reenvío pendiente en
 *    la próxima visita. Un 400 no se reintenta.
 *  - Después (solo visual): "Calculando…" → precio según m² y etapas (form-steps.ts → quoteFor, Pixel
 *    CotizacionVista) → con lote, la agenda de Hernán (ghl-booking) abajo; sin lote, redes y sin agenda.
 *  - Agendar → Pixel Schedule → /llamada-agendada (el nombre va en la pestaña, nunca en la URL).
 * Modo prueba (?modo=prueba): todo igual, con prueba=true (fila "Prueba", GHL test=true, cita "[PRUEBA]"),
 * sin Pixel ni API de conversiones.
 * Todos los links a #cotiza (y los botones con data-cta) abren el formulario en un pop-up; el VideoDock se
 * pausa y se oculta con los eventos hr:form-open / hr:form-close. El Lightbox lo abre con hr:open-form.
 * Sin JS: se ven todas las preguntas juntas y el form hace POST directo a la función.
 */
import Icon from "../illustrations/Icon.astro";
import { steps, COUNTRY_CODES, LIMITS, PROV_BA, PROV_CABA } from "../../content/form-steps";
import { totalSteps } from "../../scripts/lead";
import { form as t } from "../../content/landing";
import { site, endpoints } from "../../data/site";

const total = totalSteps({}); // sin partido ni dirección de obra hasta saber la zona (el script lo recalcula)
// Redes del descarte y de la pantalla sin lote: en el orden de form.exit.networks, solo las que tienen URL
const nets = t.exit.networks.map((k) => ({ key: k, ...site.social[k] })).filter((n) => n.url);
---

<section class="lf-sec section s-hueso s-grid" id="cotiza" aria-labelledby="lf-title">
  <!-- .lf-panel: en la página no hace nada; abierto como pop-up es la tarjeta centrada -->
  <div class="lf-panel">
    <button type="button" class="lf-close" data-lf-close aria-label={t.close} hidden>
      <Icon name="x" size={22} />
    </button>
    <div class="container lf-grid">
      <div class="lf-intro">
        <h2 id="lf-title" class="t-h1 lf-title">{t.h2}</h2>
        <p class="lf-sub">{t.sub}</p>
      </div>

      <div class="lf-card">
        <!-- Primera pantalla: texto corto y "Empezar". Sin JS queda oculta y se ve el formulario directo. -->
        <div class="lf-call" data-call hidden tabindex="-1" aria-labelledby="lf-call-title">
          <!-- Fachada de dos volúmenes (como el isotipo) con su cota en ladrillo y el precio por descubrir -->
          <svg class="lf-call__plan" viewBox="0 0 240 150" fill="none" aria-hidden="true">
            <g class="lf-call__walls">
              <path d="M40 104V64L120 26V104" />
              <path d="M120 56L196 82V104" />
              <path d="M24 104H212" />
              <path d="M56 104V82H78V104M140 78H168V94H140Z" />
            </g>
            <g class="lf-call__dim">
              <path d="M40 124H196M35 129L45 119M191 129L201 119" />
            </g>
            <rect class="lf-call__tag" x="88" y="113" width="60" height="22" />
            <text class="lf-call__tagtxt" x="118" y="128">{t.intro.tag}</text>
          </svg>
          <p class="lf-call__title t-h1" id="lf-call-title">{t.h2}</p>
          <p class="lf-call__lead">{t.intro.lead}</p>
          <p class="lf-call__text">
            {t.intro.text.split("*").map((part, k) => (k % 2 === 0 ? part : k === 1 ? <strong>{part}</strong> : <span class="lf-call__hl">{part}</span>))}
          </p>
          <button type="button" class="btn btn--lg lf-call__go" data-call-go>
            {t.intro.start}
            <Icon name="arrow-right" size={20} class="arrow" />
          </button>
        </div>

        <form class="lf" action={endpoints.lead} method="post" novalidate autocomplete="on" data-lf>
          <div class="lf-top">
            <p class="lf-stepof etiqueta" aria-live="polite">{t.stepOf(1, total)}</p>
            <div class="lf-progress" aria-hidden="true"><span class="lf-progress__bar"></span></div>
          </div>

          {
            steps.map((st, i) => (
              <fieldset class="lf-step" data-id={st.id} data-type={st.type}>
                <legend class="lf-q" id={`lf-q-${st.id}`} tabindex="-1">
                  {st.q}
                  {st.id === "partido" && <span class="lf-nojs-note">{t.noJs.partido}</span>}
                  {st.id === "direccion" && <span class="lf-nojs-note">{t.noJs.direccion}</span>}
                  {st.id === "etapas" && <span class="lf-nojs-note">{t.noJs.completo}</span>}
                </legend>
                {st.type === "contact" && <p class="lf-contact__lead">{t.contactLead}</p>}

                {st.type === "choice" && (
                  <div class:list={["lf-options", { "lf-options--2": st.cols === 2 }]}>
                    {st.options.map((o) => (
                      <label class:list={["lf-opt", { "lf-opt--desc": o.ui }]}>
                        <input type="radio" name={st.id} value={o.value} />
                        <span>
                          <span class="lf-opt__txt">
                            {o.value}
                            {o.ui && <small class="lf-opt__desc">{o.ui}</small>}
                          </span>
                        </span>
                      </label>
                    ))}
                  </div>
                )}

                {st.type === "select" && (
                  <div class="lf-field">
                    {/* Select nativo: en el celular abre la lista del sistema; en la compu se busca tecleando */}
                    <select class="lf-input lf-select" id={`lf-${st.id}`} name={st.id} aria-labelledby={`lf-q-${st.id}`}>
                      <option value="" selected disabled>
                        {st.placeholder}
                      </option>
                      {st.options.map((o, k) => (
                        <>
                          {k === st.options.length - 1 && <option disabled>──────────</option>}
                          <option value={o}>{o}</option>
                          {st.id === "provincia" && o === PROV_CABA && st.options[0] === PROV_BA && <option disabled>──────────</option>}
                        </>
                      ))}
                    </select>
                  </div>
                )}

                {st.type === "contact" && (
                  <div class="lf-contact">
                    <div class="lf-field">
                      <label class="lf-label" for="lf-nombre">
                        {t.fields.name}
                      </label>
                      <input class="lf-input" type="text" id="lf-nombre" name="nombre" autocomplete="name" autocapitalize="words" enterkeyhint="next" required minlength={LIMITS.name.min} maxlength={LIMITS.name.max} aria-describedby="lf-err-nombre" />
                      <p class="lf-ferr" id="lf-err-nombre" aria-live="polite" hidden />
                    </div>
                    <div class="lf-field">
                      <label class="lf-label" for="lf-tel">
                        {t.fields.phone}
                      </label>
                      <div class="lf-phone">
                        <label class="sr-only" for="lf-cc">
                          {t.fields.countryCode}
                        </label>
                        {/* El número usa autocomplete="tel" (número completo con +código): es lo que mejor llena
                            iOS, Android y los navegadores de Instagram/Facebook. El script lee el código que venga
                            en el número y acomoda este selector. */}
                        <select class="lf-input lf-cc" id="lf-cc" name="pais_codigo">
                          {COUNTRY_CODES.map((c, k) => (
                            <option value={c.code} data-region={c.region} selected={k === 0}>
                              {c.label}
                            </option>
                          ))}
                        </select>
                        <input class="lf-input" type="tel" id="lf-tel" name="whatsapp_num" inputmode="tel" autocomplete="tel" enterkeyhint="next" placeholder={t.fields.phonePlaceholderBy[COUNTRY_CODES[0].code] ?? t.fields.phonePlaceholder} required maxlength="24" aria-describedby="lf-err-tel" />
                      </div>
                      <p class="lf-ferr" id="lf-err-tel" aria-live="polite" hidden />
                    </div>
                    <div class="lf-field">
                      <label class="lf-label" for="lf-email">
                        {t.fields.email}
                      </label>
                      <input class="lf-input" type="email" id="lf-email" name="email" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" enterkeyhint="send" required maxlength={LIMITS.email.max} placeholder={t.fields.emailPlaceholder} aria-describedby="lf-err-email" />
                      <p class="lf-ferr" id="lf-err-email" aria-live="polite" hidden />
                      <p class="lf-suggest" data-suggest hidden>
                        <button type="button" class="lf-suggest__btn" data-template={t.emailSuggest} />
                      </p>
                    </div>
                  </div>
                )}

                {st.type !== "contact" && <p class="lf-error" role="alert" hidden />}

                <div class="lf-nav">
                  {i > 0 && (
                    <button type="button" class="lf-back" data-back>
                      <Icon name="arrow-left" size={18} />
                      {t.back}
                    </button>
                  )}
                  {st.type === "contact" ? (
                    <>
                      <button type="submit" class="btn btn--lg lf-submit">
                        <span class="lf-submit__txt">{t.submit}</span>
                        <Icon name="arrow-right" size={20} class="arrow" />
                      </button>
                      <p class="lf-consent">{t.consent}</p>
                    </>
                  ) : (
                    <button type="submit" class:list={["btn lf-next", { "lf-next--choice": st.type === "choice" }]}>
                      {t.next}
                      <Icon name="arrow-right" size={18} class="arrow" />
                    </button>
                  )}
                </div>

                {/* Confirmación del WhatsApp antes de enviar (v1.59). "Sí, es correcto" envía; "Corregir" vuelve al campo. */}
                {st.type === "contact" && (
                  <div class="lf-confirm" data-confirm hidden>
                    <p class="lf-confirm__title" id="lf-confirm-title" tabindex="-1" aria-describedby="lf-confirm-num lf-confirm-text">
                      {t.confirm.title}
                    </p>
                    <p class="lf-confirm__num" id="lf-confirm-num" dir="ltr" data-confirm-num>
                      <Icon name="whatsapp" size={26} />
                      <span data-confirm-value />
                    </p>
                    <p class="lf-confirm__text" id="lf-confirm-text" data-confirm-text>
                      {t.confirm.text}
                    </p>
                    <div class="lf-confirm__btns">
                      <button type="button" class="btn btn--lg lf-confirm__yes" data-confirm-yes>
                        {t.confirm.yes}
                        <Icon name="arrow-right" size={20} class="arrow" />
                      </button>
                      <button type="button" class="lf-back lf-confirm__fix" data-confirm-fix>
                        <Icon name="arrow-left" size={18} />
                        {t.confirm.fix}
                      </button>
                    </div>
                  </div>
                )}
              </fieldset>
            ))
          }

          <!-- Botón de origen (clave de form-steps.ts → CTA_ORIGINS): "Botón de origen" en Sheets y GHL -->
          <input type="hidden" name="modelo" value="" data-modelo />
          <!-- Anti-spam (honeypot): invisible para personas; si viene completo, no se guarda ni se mide nada.
               Nombre sin palabras que el autocompletado reconozca (name, email, tel, web, url, empresa…). -->
          <div class="lf-hp" aria-hidden="true">
            <label for="lf-k9">{t.fields.honeypot}</label>
            <input type="text" id="lf-k9" name="hr_k9" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" />
          </div>
        </form>

        <!-- Descarte: "Regularizar o medir algo ya construido". No se guarda nada (solo FormDisqualified, anónimo). -->
        <div class="lf-exit" data-exit hidden tabindex="-1" aria-labelledby="lf-exit-title">
          <p class="lf-exit__title" id="lf-exit-title">{t.exit.regularizacion.title}</p>
          <p class="lf-exit__text">{t.exit.regularizacion.text}</p>
          <a class="btn btn--lg lf-exit__wa" href="#" data-exit-wa hidden target="_blank" rel="noopener">
            <Icon name="whatsapp" size={22} />
            {t.exit.regularizacion.waButton}
          </a>
          {
            nets.length > 0 && (
              <>
                <p class="lf-nets__title">{t.exit.networksTitle}</p>
                <ul class="lf-nets">
                  {nets.map((n) => (
                    <li>
                      <a class={`lf-net lf-net--${n.key}`} href={n.url} target="_blank" rel="noopener">
                        <Icon name={n.key} size={22} />
                        <span>{n.name}</span>
                        <span class="sr-only">(se abre en otra pestaña)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
          <button type="button" class="lf-back lf-exit__back" data-exit-back>
            <Icon name="arrow-left" size={18} />
            {t.exit.back}
          </button>
        </div>

        <!-- Quiere cerrar estando en "Tus datos": se le recuerda que le falta poco (landing.ts → form.leave) -->
        <div class="lf-leave" data-leave hidden tabindex="-1" role="alertdialog" aria-labelledby="lf-leave-title">
          <p class="lf-leave__title" id="lf-leave-title">{t.leave.title}</p>
          <div class="lf-leave__btns">
            <button type="button" class="btn btn--lg" data-leave-stay>
              {t.leave.stay}
              <Icon name="arrow-right" size={20} class="arrow" />
            </button>
            <button type="button" class="lf-leave__go" data-leave-go>{t.leave.go}</button>
          </div>
        </div>

        <!-- "Calculando…" unos segundos después de enviar (solo visual: no demora ningún envío). -->
        <div class="lf-calc" data-calc hidden tabindex="-1" role="status" aria-labelledby="lf-calc-text">
          <svg class="lf-calc__plan" viewBox="0 0 200 132" fill="none" aria-hidden="true">
            <g class="lf-calc__walls">
              <path pathLength="1" d="M30 30H170V118H30Z" />
              <path pathLength="1" d="M95 30V78M95 96V118M95 78H140M158 78H170M30 70H62M78 70H95" />
            </g>
            <g class="lf-calc__dim">
              <path pathLength="1" d="M30 14H170M25 19L35 9M165 19L175 9" />
              <path pathLength="1" d="M186 30V118M181 35L191 25M181 123L191 113" />
            </g>
            <path class="lf-calc__door" pathLength="1" d="M62 70a16 16 0 0 1 16 -16" />
          </svg>
          <p class="lf-calc__text" id="lf-calc-text">{t.quote.loading}</p>
        </div>

        <!-- Precio para quien todavía no tiene el lote: sin agenda, con las redes. -->
        <div class="lf-quote" data-quote hidden tabindex="-1" aria-labelledby="lf-quote-title">
          <div class="lf-price" data-price>
            <p class="lf-price__label etiqueta" id="lf-quote-title">{t.quote.label}</p>
            <p class="lf-price__amount" data-quote-amount />
            <p class="lf-price__meta" data-quote-meta />
            <p class="lf-price__extras">{t.quote.extras}</p>
          </div>
          <p class="lf-quote__ask">{t.quote.noLandTitle}</p>
          <p class="lf-quote__note">{t.quote.noLandText}</p>
          {
            nets.length > 0 && (
              <ul class="lf-nets">
                {nets.map((n) => (
                  <li>
                    <a class={`lf-net lf-net--${n.key}`} href={n.url} target="_blank" rel="noopener">
                      <Icon name={n.key} size={22} />
                      <span>{n.name}</span>
                      <span class="sr-only">(se abre en otra pestaña)</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <!-- Con lote: precio arriba y la agenda de Hernán abajo (días y horarios libres de GHL en la hora local,
             sin volver a pedir datos). Si la agenda no carga: el calendario de GHL (iframe con los datos
             precargados) y, si hay número, el WhatsApp. Sin calendario ni WhatsApp: success.noCalendar. -->
        <div class="lf-done" hidden tabindex="-1" aria-labelledby="lf-done-title">
          <div class="lf-price" data-price>
            <p class="lf-price__label etiqueta">{t.quote.label}</p>
            <p class="lf-price__amount" data-quote-amount />
            <p class="lf-price__meta" data-quote-meta />
            <p class="lf-price__extras">{t.quote.extras}</p>
          </div>
          <div class="lf-done__intro">
            <div class="lf-host">
              <span class="lf-host__av">
                <img src={t.agenda.avatar} alt={t.agenda.avatarAlt} width="64" height="64" loading="lazy" decoding="async" />
                <span class="lf-host__cam" aria-hidden="true"><Icon name="video" size={14} /></span>
              </span>
              <div class="lf-host__info">
                <p class="lf-done__title" id="lf-done-title">{t.agenda.title}</p>
                <p class="lf-host__meta">
                  {/* El separador va afuera de cada dato: la línea puede cortar entre datos, nunca adentro de uno */}
                  {[t.agenda.hostName, ...t.agenda.hostStats].map((x, i) => (
                    <>
                      {i > 0 && " · "}
                      <span>{x}</span>
                    </>
                  ))}
                </p>
              </div>
            </div>
            <p class="sr-only">{t.agenda.lead}</p>
            <ul class="lf-gets">
              {
                t.agenda.takeaways.map((x) => (
                  <li>
                    <span class="lf-gets__tick" aria-hidden="true">
                      <Icon name="check" size={16} />
                    </span>
                    <span>{x}</span>
                  </li>
                ))
              }
            </ul>
            <p class="lf-partner" data-partner hidden />
          </div>
          <p class="lf-book__msg" data-book-msg role="status" />
          <div class="lf-book" data-book hidden>
            <p class="lf-book__step" id="lf-days-label">{t.success.calendarDays}</p>
            <div class="lf-days" data-days role="group" aria-labelledby="lf-days-label" />
            <p class="lf-book__step" id="lf-slots-label" data-slots-label />
            <div class="lf-slots" data-slots role="group" aria-labelledby="lf-slots-label" />
            <p class="lf-book__tz" data-tz />
            <div class="lf-book__bar">
              <button type="button" class="btn btn--lg lf-book__go" data-book-go disabled>{t.success.calendarPick}</button>
            </div>
          </div>
          <!-- Respaldo: el calendario de GHL (si la agenda de arriba no carga y hay link de calendario) -->
          <iframe class="lf-cal__frame" title={t.success.calendarFrame} data-cal-frame hidden></iframe>
          <!-- WhatsApp: solo si la agenda no carga y hay número cargado en site.ts -->
          <p class="lf-done__nowa" data-nowa hidden>
            {t.success.noWa} <a href="#" data-wa target="_blank" rel="noopener">{site.whatsappDisplay}</a>
          </p>
        </div>
        <!-- Cita agendada: lleva a /llamada-agendada (video de Hernán y botón a WhatsApp) -->
      </div>
    </div>
  </div>
</section>

<style>
  .lf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  /* Ningún contenido largo (montos, días, datos en mono) ensancha la tarjeta: se acomoda adentro */
  .lf-grid > *,
  .lf-card > *,
  .lf-done > *,
  .lf-quote > *,
  .lf-exit > * {
    min-width: 0;
    max-width: 100%;
  }
  .lf-title {
    max-width: 14ch;
  }
  /* "Al terminar vas a ver el precio…": solo mientras responde */
  .lf-sub {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--tinta-2);
  }
  .lf-grid:has(.lf-call:not([hidden]), .lf-calc:not([hidden]), .lf-quote:not([hidden]), .lf-done:not([hidden]), .lf-exit:not([hidden]), .lf-leave:not([hidden])) .lf-sub {
    display: none;
  }

  /* ---- Tarjeta (en la página): superficie sobre la grilla, borde fino ---- */
  .lf-card {
    background: var(--superficie);
    color: var(--tinta);
    border: 1px solid var(--linea);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-3);
    min-height: 24rem;
  }
  @media (min-width: 640px) {
    .lf-card {
      padding: var(--space-5);
    }
  }
  @media (min-width: 1024px) {
    .lf-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-6);
    }
    .lf-intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* ---- Primera pantalla: fachada con cota, título, lead, texto y botón ---- */
  .lf-call {
    display: grid;
    justify-items: start;
    outline: none;
  }
  .lf-call[hidden] {
    display: none;
  }
  .lf-call__plan {
    width: min(15rem, 72%);
    height: auto;
    margin-bottom: var(--space-4);
    overflow: visible;
  }
  .lf-call__plan path,
  .lf-call__plan rect {
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
  }
  .lf-call__walls path {
    stroke: var(--tinta);
  }
  .lf-call__dim path {
    stroke: var(--c-ladrillo);
  }
  .lf-call__tag {
    fill: var(--superficie);
    stroke: var(--tinta);
  }
  .lf-call__tagtxt {
    fill: var(--ladrillo-texto);
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }
  .lf-call__lead {
    margin-top: var(--space-3);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .lf-call__text {
    margin-top: var(--space-2);
    font-size: var(--fs-body-lg);
    line-height: 1.5;
    color: var(--tinta-2);
    max-width: 36ch;
    text-wrap: pretty;
  }
  .lf-call__text strong {
    color: var(--tinta);
    font-weight: 700;
  }
  .lf-call__hl {
    color: var(--ladrillo-texto);
    font-weight: 700;
  }
  .lf-call__go {
    margin-top: var(--space-4);
  }
  @media (min-width: 768px) {
    .lf-call {
      grid-template-columns: minmax(0, 1fr) minmax(11rem, 16rem);
      column-gap: var(--space-5);
      align-items: center;
    }
    .lf-call > :not(.lf-call__plan) {
      grid-column: 1;
    }
    .lf-call__plan {
      grid-column: 2;
      grid-row: 1 / span 4;
      width: 100%;
      margin: 0;
    }
  }
  /* En la página (no en el pop-up) el título ya está al lado (h2 de la sección): no se repite */
  .lf-sec:not(.is-modal) .lf-call__title {
    display: none;
  }
  .lf-sec:not(.is-modal) .lf-call__lead {
    margin-top: 0;
  }
  @media (max-width: 639px) {
    .lf-call__go,
    .lf-exit__wa {
      width: 100%;
    }
  }

  /* ---- "Calculando…": plano con cotas que se dibuja (tinta 1,5 px, cotas en ladrillo) ---- */
  .lf-calc {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    text-align: center;
    outline: none;
  }
  .lf-calc[hidden],
  .lf-quote[hidden] {
    display: none;
  }
  .lf-calc__plan {
    width: min(16rem, 80%);
    height: auto;
    overflow: visible;
  }
  .lf-calc__plan path {
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
  }
  .lf-calc__walls path,
  .lf-calc__door {
    stroke: var(--tinta);
  }
  .lf-calc__dim path {
    stroke: var(--c-ladrillo);
  }
  .lf-calc__door {
    stroke-dasharray: none;
    opacity: 0;
  }
  .lf-calc.is-on .lf-calc__walls path:first-child {
    animation: lf-draw 0.9s var(--ease) forwards;
  }
  .lf-calc.is-on .lf-calc__walls path:last-child {
    animation: lf-draw 0.7s var(--ease) 0.7s forwards;
  }
  .lf-calc.is-on .lf-calc__dim path {
    animation: lf-draw 0.6s var(--ease) 1.3s forwards;
  }
  .lf-calc.is-on .lf-calc__door {
    animation: lf-fade 0.4s var(--ease) 1.8s forwards;
  }
  @keyframes lf-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes lf-fade {
    to {
      opacity: 1;
    }
  }
  .lf-calc__text {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  @media (prefers-reduced-motion: reduce) {
    .lf-calc__plan path {
      stroke-dashoffset: 0;
      animation: none !important;
    }
    .lf-calc__door {
      opacity: 1;
    }
  }

  /* ---- Precio: etiqueta mono, el rango grande en ladrillo (≥24 px), para qué es y lo que no incluye ---- */
  .lf-quote {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    justify-items: start;
    outline: none;
  }
  .lf-quote__ask {
    margin-top: var(--space-2);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .lf-quote__note {
    color: var(--tinta-2);
    max-width: 52ch;
  }
  .lf-price {
    display: grid;
    gap: var(--space-2);
    justify-self: stretch;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--linea);
  }
  .lf-price__label {
    padding-right: 3rem; /* la X de cerrar */
  }
  .lf-price__amount {
    font-family: var(--f-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    /* "USD 8.000 – USD 11.500" entra en una línea desde 360 px; si no, corta antes del guion */
    font-size: clamp(1.5rem, 6.4vw, 2rem);
    line-height: 1.08;
    color: var(--c-ladrillo);
    font-variant-numeric: tabular-nums;
  }
  .lf-price__amount :global(span) {
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .lf-price__amount {
      font-size: clamp(2rem, 5vw, 3rem);
    }
  }
  .lf-price__meta {
    font-family: var(--f-mono);
    font-size: var(--fs-dato);
    line-height: 1.47;
    color: var(--tinta);
  }
  /* La línea fija de lo que no incluye (el miedo nº 1: que aparezca algo más para pagar) */
  .lf-price__extras {
    font-size: var(--fs-small);
    line-height: 1.47;
    color: var(--tinta-2);
    max-width: 52ch;
  }
  /* Aparición: primero el precio; el resto (agenda o redes) un momento después. Solo transform y opacity. */
  .lf-reveal .lf-price {
    animation: lf-rise 0.5s var(--ease) both;
  }
  .lf-reveal > :not(.lf-price) {
    animation: lf-rise 0.5s var(--ease) 0.9s both;
  }
  @keyframes lf-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lf-reveal .lf-price,
    .lf-reveal > :not(.lf-price) {
      animation: none;
    }
  }

  /* ---- Agenda: quién te atiende, qué te llevás y los horarios ---- */
  .lf-done__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .lf-host {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lf-host__av {
    position: relative;
    flex: none;
  }
  .lf-host__av img {
    display: block;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .lf-host__cam {
    position: absolute;
    right: -0.25rem;
    bottom: -0.125rem;
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background: var(--superficie);
    color: var(--tinta);
    border: 1px solid var(--tinta);
  }
  .lf-host__info {
    flex: 1 1 auto;
    min-width: 0;
  }
  .lf-done__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }
  .lf-host__meta {
    margin-top: 0.25rem;
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--tinta-2);
  }
  .lf-host__meta span {
    white-space: nowrap;
  }
  .lf-gets {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    line-height: 1.35;
  }
  .lf-gets li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .lf-gets__tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.05rem;
    border: 1px solid var(--tinta);
    border-radius: var(--radius-sm);
    color: var(--ladrillo-texto);
  }
  .lf-gets__tick :global(.ico) {
    stroke-width: 2;
  }
  .lf-partner {
    font-size: var(--fs-small);
    color: var(--tinta-2);
  }
  @media (max-width: 639px) {
    .lf-host {
      align-items: flex-start;
      gap: 0.875rem;
    }
    .lf-host__av img {
      width: 3.5rem;
      height: 3.5rem;
    }
    .lf-done__title {
      font-size: 1.1875rem;
    }
  }

  /* ---- Pasos ---- */
  .lf-top {
    margin-bottom: var(--space-4);
  }
  .lf-stepof {
    margin-bottom: var(--space-2);
  }
  .lf-stepof :global(.lf-last) {
    color: var(--ladrillo-texto);
  }
  .lf-progress {
    height: 4px;
    background: var(--linea);
  }
  .lf-progress__bar {
    display: block;
    height: 100%;
    width: 12%;
    background: var(--c-ladrillo);
    transition: width 0.4s var(--ease);
  }
  .lf-step {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .lf-step + .lf-step {
    margin-top: var(--space-6);
  }
  .lf.lf--js .lf-step + .lf-step {
    margin-top: 0;
  }
  .lf-q {
    display: block;
    padding: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin-bottom: var(--space-4);
    outline: none;
  }
  /* Avisos de las preguntas que dependen de otra: solo sin JS (todas las preguntas juntas) */
  .lf-nojs-note {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--f-body);
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--tinta-2);
  }
  .lf--js .lf-nojs-note {
    display: none;
  }

  /* ---- Opciones: borde fino; la elegida, borde en tinta y el cuadrado relleno en ladrillo ---- */
  .lf-options {
    display: grid;
    gap: var(--space-2);
  }
  .lf-options--2 {
    grid-template-columns: 1fr 1fr;
  }
  .lf-opt {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .lf-opt[hidden] {
    display: none;
  }
  .lf-opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .lf-opt > span {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.75rem var(--space-3);
    border: 1.5px solid var(--linea);
    border-radius: var(--radius-md);
    background: var(--fondo);
    font-weight: 600;
    line-height: 1.25;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }
  .lf-opt > span::before {
    content: "";
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 1.5px solid var(--tinta);
    border-radius: var(--radius-sm);
    background: var(--superficie);
  }
  .lf-opt:hover > span {
    border-color: var(--tinta);
  }
  .lf-opt input:checked + span {
    border-color: var(--tinta);
    background: var(--superficie);
  }
  .lf-opt input:checked + span::before {
    background: var(--c-ladrillo);
    border-color: var(--c-ladrillo);
    box-shadow: inset 0 0 0 3px var(--superficie);
  }
  .lf-opt input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .lf-opt__txt {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .lf-opt__desc {
    font-size: var(--fs-small);
    font-weight: 400;
    line-height: 1.35;
    color: var(--tinta-2);
  }

  /* ---- Campos ---- */
  .lf-label {
    display: block;
    font-weight: 600;
    font-size: var(--fs-small);
    margin-bottom: 0.375rem;
  }
  .lf-field + .lf-field {
    margin-top: var(--space-3);
  }
  .lf-contact .lf-field + .lf-field {
    margin-top: var(--space-4);
  }
  .lf-input {
    width: 100%;
    min-height: 3.5rem;
    padding: 0.75rem var(--space-3);
    border: 1.5px solid var(--linea);
    border-radius: var(--radius-sm);
    background: var(--superficie);
    color: var(--tinta);
    font-size: 1.0625rem; /* ≥16px: evita el zoom de iOS */
  }
  .lf-input::placeholder {
    color: var(--tinta-2);
    opacity: 0.75;
  }
  .lf-input:hover {
    border-color: var(--tinta);
  }
  .lf-input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-color: var(--tinta);
  }
  .lf-input[aria-invalid="true"] {
    border-color: var(--ladrillo-texto);
    box-shadow: inset 0 0 0 1px var(--ladrillo-texto);
  }
  /* Selects nativos grandes, con flecha propia */
  .lf-input.lf-select,
  .lf-cc {
    appearance: none;
    font-weight: 600;
    background-image: linear-gradient(45deg, transparent 50%, var(--tinta) 50%), linear-gradient(135deg, var(--tinta) 50%, transparent 50%);
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }
  .lf-input.lf-select {
    padding-right: 2.75rem;
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 16px) 50%;
  }
  .lf-cc {
    padding-inline: 0.75rem 1.75rem;
    background-position:
      calc(100% - 16px) 50%,
      calc(100% - 10px) 50%;
  }
  .lf-phone {
    display: grid;
    grid-template-columns: 7.75rem 1fr;
    gap: var(--space-2);
  }
  .lf-ferr {
    margin-top: 0.375rem;
    color: var(--ladrillo-texto);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.4;
  }
  .lf-error {
    margin-top: var(--space-3);
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--ladrillo-texto);
    border-radius: var(--radius-sm);
    background: var(--superficie);
    color: var(--ladrillo-texto);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .lf-contact__lead {
    margin-top: calc(-1 * var(--space-2));
    margin-bottom: var(--space-4);
    color: var(--tinta-2);
    max-width: 48ch;
  }
  .lf-suggest {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
  }
  .lf-suggest__btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ladrillo-texto);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-align: left;
  }
  /* Honeypot: fuera de la pantalla (no display:none, que algunos bots detectan) */
  .lf-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---- Navegación ---- */
  .lf-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .lf-nav > :only-child {
    margin-left: auto;
  }
  .lf-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--tap);
    padding: 0 0.5rem 0 0;
    border: 0;
    background: none;
    color: var(--tinta);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  /* En opción múltiple no hay "Siguiente": avanza solo al tocar. Aparece si vuelve a un paso ya respondido
     o con teclado. */
  .lf--js .lf-next--choice {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .lf--js .lf-next--choice:focus-visible,
  .lf--js .lf-step.is-return:has(input:checked) .lf-next--choice {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
  }
  /* "Tus datos": botón a todo el ancho, debajo el texto legal y al final "Atrás" */
  .lf-nav:has(.lf-submit) {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: var(--space-5);
  }
  .lf-nav .lf-submit {
    order: -1;
    width: 100%;
  }
  .lf-consent {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--tinta-2);
    text-align: center;
  }
  .lf-nav:has(.lf-submit) .lf-back {
    order: 1;
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  /* ---- Confirmación del WhatsApp: mientras se ve, quedan solo "Tus datos" y la confirmación ---- */
  .lf-step.is-confirming > :not(legend, .lf-confirm) {
    display: none;
  }
  .lf-confirm {
    margin-top: var(--space-3);
  }
  .lf-confirm__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
  }
  .lf-confirm__title:focus {
    outline: none; /* foco puesto por el script, para que lo lea el lector de pantalla */
  }
  /* El número, grande y en una línea, dentro de un rótulo */
  .lf-confirm__num {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-4);
    padding: 1rem 1.125rem;
    border: 1px solid var(--tinta);
    border-radius: var(--radius-sm);
    background: var(--superficie);
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: clamp(1.25rem, 0.7rem + 3vw, 2rem); /* +54 9 11 2345-6789 entra en una línea desde 320 px */
    line-height: 1.15;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .lf-confirm__num :global(svg) {
    flex: none;
    color: var(--ladrillo-texto);
  }
  .lf-confirm__num.is-long {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .lf-confirm__text {
    margin-top: var(--space-3);
    color: var(--tinta-2);
    max-width: 48ch;
  }
  .lf-confirm__btns {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-5);
  }
  .lf-confirm__yes {
    width: 100%;
  }

  /* ---- Descarte y "te falta un paso" ---- */
  .lf-exit,
  .lf-done {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    justify-items: start;
    outline: none;
  }
  .lf-exit[hidden],
  .lf-done[hidden] {
    display: none;
  }
  .lf-exit__title,
  .lf-leave__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
  }
  .lf-exit__text {
    color: var(--tinta-2);
    max-width: 56ch;
  }
  .lf-exit__back {
    margin-top: var(--space-2);
  }
  .lf-leave__btns {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-5);
  }
  .lf-leave__go {
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--tinta-2);
    font: inherit;
    font-size: var(--fs-small);
    text-decoration: underline;
    cursor: pointer;
  }
  @media (max-width: 639px) {
    .lf-leave__btns .btn {
      width: 100%;
    }
  }
  .lf-nets__title {
    margin-top: var(--space-2);
    font-weight: 600;
  }
  /* Redes: botones iguales, grandes y fáciles de tocar */
  .lf-nets {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: var(--space-2);
    width: 100%;
  }
  .lf-net {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--tap);
    padding: 0.625rem var(--space-3);
    border: 1.5px solid var(--tinta);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .lf-net:hover {
    background: var(--tinta);
    color: var(--fondo);
  }

  /* ---- Horarios ---- */
  .lf-done > .lf-book,
  .lf-done > .lf-cal__frame,
  .lf-done > .lf-book__msg {
    justify-self: stretch;
  }
  .lf-cal__frame[hidden],
  .lf-done__nowa[hidden],
  .lf-book[hidden],
  .lf-book__msg:empty {
    display: none;
  }
  .lf-book {
    display: grid;
    gap: var(--space-3);
  }
  .lf-book__tz,
  .lf-book__msg {
    font-size: var(--fs-small);
    color: var(--tinta-2);
  }
  .lf-book__step {
    margin-bottom: calc(-1 * var(--space-2));
    font-family: var(--f-mono);
    font-size: var(--fs-etiqueta);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
  .lf-book__step:empty {
    display: none;
  }
  .lf-days {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }
  .lf-days :global(.lf-day),
  .lf-slots :global(.lf-slot) {
    border: 1.5px solid var(--linea);
    border-radius: var(--radius-md);
    background: var(--fondo);
    color: var(--tinta);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .lf-days :global(.lf-day) {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    min-width: 4.25rem;
    padding: 0.5rem 0.625rem;
    line-height: 1.15;
  }
  .lf-days :global(.lf-day small) {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }
