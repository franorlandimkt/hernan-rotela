---
/**
 * ¿Todavía no tenés el lote?: para quien lo va a comprar en 6–12 meses. Educa (qué mirar antes de comprar)
 * y lo lleva a TikTok (sin agenda todavía). El botón de TikTok sale solo si hay URL en site.ts.
 * Igual puede hacer el formulario: queda como "Sin terreno" (LeadSinTerreno) y ve el precio.
 */
import SectionHead from "../ui/SectionHead.astro";
import Icon from "../illustrations/Icon.astro";
import { beforeLot as t } from "../../content/landing";
import { site } from "../../data/site";
---

<section class="section s-superficie before" id="sin-lote" aria-labelledby="sin-lote-title">
  <div class="container before__in">
    <div>
      <SectionHead label={t.label} title={t.h2} sub={t.sub} id="sin-lote-title" />
    </div>
    <div class="before__body reveal">
      <ol class="before__list">
        {t.checks.map((c, i) => (
          <li>
            <span class="dato before__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span>{c}</span>
          </li>
        ))}
      </ol>
      <p class="before__text">{t.text}</p>
      <div class="cta-row before__ctas">
        {
          site.social.tiktok.url && (
            <a class="btn btn--lg" href={site.social.tiktok.url} target="_blank" rel="noopener" data-social="tiktok">
              <Icon name="tiktok" size={20} />
              {t.ctaSocial}
            </a>
          )
        }
        <a class:list={["btn btn--lg", { "btn--ghost": !!site.social.tiktok.url }]} href="#cotiza" data-cta="sin-lote">
          {t.cta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .before__in {
    display: grid;
    gap: var(--space-4);
  }
  .before__list {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--tinta);
  }
  .before__list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--linea);
  }
  .before__n {
    color: var(--ladrillo-texto);
  }
  .before__text {
    margin-top: var(--space-4);
    color: var(--tinta-2);
    max-width: 40rem;
  }
  .before__ctas {
    margin-top: var(--space-4);
  }
  @media (max-width: 479px) {
    .before__ctas .btn {
      width: 100%;
    }
  }
  @media (min-width: 1024px) {
    .before__in {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-6);
      align-items: start;
    }
  }
</style>
