---
/** Encabezado de sección: etiqueta mono + H2 (estilo "h1" del manual) + bajada.
 *  En el título, lo que va entre *asteriscos* va en ladrillo; en la bajada, **dobles** = negrita. */
import Marked from "./Marked.astro";
interface Props {
  label?: string;
  title: string;
  sub?: string;
  center?: boolean;
  id?: string;
}
const { label, title, sub, center = false, id } = Astro.props;
---

<header class:list={["sec-head reveal", { "sec-head--center": center }]}>
  {label && <span class="etiqueta">{label}</span>}
  <h2 class="t-h1" id={id}><Marked text={title} /></h2>
  {sub && <p class="lead"><Marked text={sub} /></p>}
  <slot />
</header>
