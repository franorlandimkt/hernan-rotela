<script>
  import { EMAIL_RE, isOrigin, LIMITS, QUESTION_IDS, PHONE_DIGITS, QUOTE_LOADING_MS, STEP_NUMBER, etapasFor, etapaOf, inRadius, quoteFor } from "../../content/form-steps";
  import { form as copy } from "../../content/landing";
  import { track, trackCustom, trackFunnel, trackOnce, getAttribution, newEventId, consentDenied, getFbp, getFbc, isTestMode } from "../../scripts/tracking";
  import { nextStep, totalSteps, activeSteps, exitReason, EXIT, qualifies, isHot, cleanAnswers, type FlowAnswers } from "../../scripts/lead";
  import { site, endpoints, waLink, calendarLink, usd } from "../../data/site";
  import { readPhone, maskPhone, loadPhoneLib } from "../../scripts/phone";

  // Envío en segundo plano mientras la persona lee la pantalla siguiente (no bloquea nada).
  // Hasta ATTEMPTS intentos dentro de SEND_BUDGET_MS; la función usa hasta ~7.5 s por intento con Sheets.
  const SEND_BUDGET_MS = 25000;
  const ATTEMPTS = 3;
  const DEFAULT_TZ = "America/Argentina/Buenos_Aires";

  /** Errores de tipeo comunes en el dominio del email → sugerencia (no bloquea el envío). */
  const EMAIL_FIX: Record<string, string> = {
    "gmail.con": "gmail.com", "gmail.co": "gmail.com", "gmail.cm": "gmail.com", "gmail.om": "gmail.com", "gmial.com": "gmail.com", "gmai.com": "gmail.com", "gmal.com": "gmail.com", "gamil.com": "gmail.com", "gnail.com": "gmail.com", "gmail.comm": "gmail.com", "gmail.com.ar": "gmail.com",
    "hotmail.con": "hotmail.com", "hotmail.co": "hotmail.com", "hotmial.com": "hotmail.com", "hotmal.com": "hotmail.com", "hotmai.com": "hotmail.com", "homail.com": "hotmail.com", "hotmail.com.ar.": "hotmail.com.ar",
    "yahoo.con": "yahoo.com", "yaho.com": "yahoo.com", "yhoo.com": "yahoo.com", "yahoo.com.ar.": "yahoo.com.ar",
    "outlook.con": "outlook.com", "outlok.com": "outlook.com", "outllok.com": "outlook.com",
    "icloud.con": "icloud.com", "icloud.co": "icloud.com", "iclod.com": "icloud.com", "icoud.com": "icloud.com",
  };

  const form = document.querySelector<HTMLFormElement>("[data-lf]");
  if (form) init(form);

  function init(form: HTMLFormElement) {
    form.classList.add("lf--js");
    const all = [...form.querySelectorAll<HTMLFieldSetElement>(".lf-step")];
    const byId = (id: string) => all.find((s) => s.dataset.id === id);
    const bar = form.querySelector<HTMLElement>(".lf-progress__bar")!;
    const stepOf = form.querySelector<HTMLElement>(".lf-stepof")!;
    const card = form.closest<HTMLElement>(".lf-card")!;
    const callIntro = card.querySelector<HTMLElement>("[data-call]")!;
    const done = card.querySelector<HTMLElement>(".lf-done")!;
    const calc = card.querySelector<HTMLElement>("[data-calc]")!;
    const quote = card.querySelector<HTMLElement>("[data-quote]")!;
    const exit = card.querySelector<HTMLElement>("[data-exit]")!;
    const leave = card.querySelector<HTMLElement>("[data-leave]")!;
    const modelo = form.querySelector<HTMLInputElement>("[data-modelo]")!;
    const nameIn = form.querySelector<HTMLInputElement>("#lf-nombre")!;
    const tel = form.querySelector<HTMLInputElement>("#lf-tel")!;
    const ccSel = form.querySelector<HTMLSelectElement>("#lf-cc")!;
    const email = form.querySelector<HTMLInputElement>("#lf-email")!;
    const suggest = form.querySelector<HTMLElement>("[data-suggest]")!;
    const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    /** Camino recorrido (ids de pantallas). El último es la pantalla actual. */
    let path: string[] = [all[0].dataset.id!];
    let cur = all[0];
    let viaPointer = false;
    /** Ya envió: el lead se mide y se envía una sola vez por página. */
    let finished = false;
    /** Mientras arranca no se guarda el estado (no pisa lo guardado antes de leerlo). */
    let stateLocked = true;

    const value = (name: string) => {
      const el = form.elements.namedItem(name);
      if (el instanceof RadioNodeList) return el.value;
      return el instanceof HTMLInputElement || el instanceof HTMLSelectElement ? el.value.trim() : "";
    };
    const flow = (): FlowAnswers => Object.fromEntries(QUESTION_IDS.map((k) => [k, value(k)]));
    /** Borra la respuesta de una pregunta (radios o select). */
    function clearAnswer(id: string) {
      form.querySelectorAll<HTMLInputElement>(`input[name="${id}"]`).forEach((r) => (r.checked = false));
      const sel = form.querySelector<HTMLSelectElement>(`select[name="${id}"]`);
      if (sel) sel.selectedIndex = 0;
    }

    // ---------- Pasos ----------
    /** Deja la tarjeta del formulario arriba de la pantalla (sobre todo en el celular). */
    function toTop() {
      const behavior = reduce() ? "auto" : "smooth";
      const top = card.getBoundingClientRect().top;
      if (open) {
        // pop-up: se desplaza solo su contenido (la página de atrás no se mueve)
        const d = top - scroller.getBoundingClientRect().top - 12;
        if (Math.abs(d) > 24) scroller.scrollBy({ top: d, behavior });
        return;
      }
      const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      if (top < 0 || top > pad + 24) card.scrollIntoView({ behavior, block: "start" });
    }
    /** Etapas: fuera del radio no se ofrece el proyecto completo con plano municipal. */
    function syncEtapas() {
      const allowed = etapasFor(flow()).map((e) => e.value);
      byId("etapas")
        ?.querySelectorAll<HTMLLabelElement>(".lf-opt")
        .forEach((l) => {
          const input = l.querySelector<HTMLInputElement>("input")!;
          const off = !allowed.includes(input.value);
          l.hidden = off;
          input.disabled = off;
          if (off && input.checked) input.checked = false;
        });
    }
    function show(step: HTMLFieldSetElement, focus = true) {
      cur = step;
      // validación del WhatsApp: se baja cuando empieza a responder, no con la página
      if (focus) void loadPhoneLib();
      if (step.dataset.id === "etapas") syncEtapas();
      // paso ya respondido (volvió atrás o retoma): se ve "Siguiente"
      if (step.querySelector("input:checked")) step.classList.add("is-return");
      const n = path.length;
      const total = totalSteps(flow());
      all.forEach((s) => (s.hidden = s !== step));
      callIntro.hidden = true;
      exit.hidden = true;
      leave.hidden = true;
      form.hidden = false;
      bar.style.width = `${(n / total) * 100}%`;
      stepOf.textContent = copy.stepOf(n, total);
      if (step.dataset.id === "contacto") {
        const last = document.createElement("span");
        last.className = "lf-last";
        last.textContent = ` · ${copy.lastStep}`;
        stepOf.append(last);
      }
      saveState();
      if (focus) {
        step.querySelector<HTMLElement>(".lf-q")!.focus({ preventScroll: true });
        toTop();
      }
    }
    /** Descarte (regularización): no se envía ni se guarda nada. Pixel FormDisqualified, anónimo. */
    function showExit() {
      const waBtn = exit.querySelector<HTMLAnchorElement>("[data-exit-wa]")!;
      const href = waLink(copy.exit.regularizacion.waMessage);
      waBtn.hidden = !href;
      if (href) waBtn.href = href;
      if (href && !waBtn.dataset.bound) {
        waBtn.dataset.bound = "1";
        waBtn.addEventListener("click", () => trackOnce("wa", "ClickWhatsApp"));
      }
      form.hidden = true;
      exit.hidden = false;
      exit.focus({ preventScroll: true });
      toTop();
      clearState();
      const reason = exitReason(cur.dataset.id!, flow());
      trackFunnel(`disq:${reason}`, "FormDisqualified", { reason });
    }
    /**
     * Borra las respuestas que dejaron de aplicar al cambiar una rama: preguntas que ya no corresponden
     * (lead.ts → activeSteps) y el proyecto completo si el lote quedó fuera del radio. Lo demás se conserva.
     */
    function clearOffPath() {
      const act = activeSteps(flow());
      QUESTION_IDS.forEach((id) => !act.includes(id) && clearAnswer(id));
      if (etapaOf(value("etapas"))?.radiusOnly && !inRadius(flow())) clearAnswer("etapas");
    }
    function next() {
      if (finished || !validate(cur)) return;
      const id = cur.dataset.id!;
      // si volvió atrás y respondió de nuevo, se recalcula el camino desde acá
      path = path.slice(0, path.indexOf(id) + 1);
      clearOffPath();
      const to = nextStep(id, flow());
      if (to === EXIT) return showExit();
      // Pixel: FormStep con el número fijo de la pregunta respondida (una vez por sesión y paso)
      trackFunnel(`step:${id}`, "FormStep", { step: STEP_NUMBER[id], step_name: id });
      path.push(to);
      show(byId(to)!);
    }
    function back() {
      if (path.length <= 1) return;
      path.pop();
      const prev = byId(path[path.length - 1])!;
      prev.classList.add("is-return");
      show(prev);
    }

    // ---------- Validación (mismos mínimos que las funciones: LIMITS, EMAIL_RE, parsePhone) ----------
    function setError(step: HTMLElement, msg: string) {
      const el = step.querySelector<HTMLElement>(".lf-error");
      if (!el) return !msg;
      el.textContent = msg;
      el.hidden = !msg;
      return !msg;
    }
    /** Error debajo de un campo de "Tus datos" ("" = sin error). */
    function fieldError(input: HTMLElement, msg: string) {
      const el = document.getElementById(input.getAttribute("aria-describedby") || "");
      if (el) {
        el.textContent = msg;
        el.hidden = !msg;
      }
      if (msg) input.setAttribute("aria-invalid", "true");
      else input.removeAttribute("aria-invalid");
      return !msg;
    }
    /** Dígitos en el nombre: 7 o más = parece un teléfono. */
    const NAME_PHONE_DIGITS = 7;
    const nameDigits = () => nameIn.value.replace(/\D/g, "").length;
    /** El número que estaba en el nombre ya pasó al WhatsApp: hasta que escriba, sigue el mismo aviso. */
    let nameWasPhone = false;
    const nameMsg = () => {
      const d = nameDigits();
      if (d >= NAME_PHONE_DIGITS || (nameWasPhone && !nameIn.value.trim())) return copy.errors.nameIsPhone;
      if (d) return copy.errors.nameDigits;
      return nameIn.value.trim().replace(/\s+/g, " ").length < LIMITS.name.min ? copy.errors.name : "";
    };
    /**
     * Error del WhatsApp: si faltan o sobran dígitos para ese país, o si ese número no existe ahí.
     * Argentina: se cuentan los 10 de característica + número (el 9, el 0 y el 15 se acomodan solos).
     */
    const telMsg = () => {
      const p = readPhone(tel.value, ccSel.value);
      if (p.ok) return "";
      if (ccSel.value === "otro" || !p.cc) return copy.errors.phoneIntl;
      const fill = (m: string, want: number, have: number) => m.replace("{cc}", p.cc).replace("{want}", String(want)).replace("{have}", String(have));
      if (p.lengthOk) return fill(copy.errors.phoneInvalid, 0, 0);
      if (p.cc === "54") {
        const core = p.num.length === 11 && p.num.startsWith("9") ? p.num.slice(1) : p.num;
        if (core.length && core.length < 10) return fill(copy.errors.phoneShortAR, 10, core.length);
        if (core.length > 10) return copy.errors.phoneLongAR;
        return copy.errors.phone;
      }
      const want = PHONE_DIGITS[p.cc];
      if (want && p.num.length && p.num.length < want) return fill(copy.errors.phoneShort, want, p.num.length);
      if (want && p.num.length > want) return fill(copy.errors.phoneLong, want, p.num.length);
      return copy.errors.phone;
    };
    const emailMsg = () => (EMAIL_RE.test(email.value.trim()) ? "" : copy.errors.email);
    function validate(step: HTMLFieldSetElement): boolean {
      const type = step.dataset.type;
      if (type === "choice") return setError(step, step.querySelector("input:checked") ? "" : copy.errors.choice);
      if (type === "select") return setError(step, step.querySelector<HTMLSelectElement>("select")!.value ? "" : copy.errors.select);
      // Tus datos: se marcan todos los campos con problema y el foco va al primero (nunca se borra lo escrito)
      const checks: [HTMLInputElement, string][] = [
        [nameIn, nameMsg()],
        [tel, telMsg()],
        [email, emailMsg()],
      ];
      checks.forEach(([el, msg]) => fieldError(el, msg));
      const bad = checks.find(([, msg]) => msg);
      bad?.[0].focus();
      return !bad;
    }

    // ---------- Teléfono y email (en blur: no se pisa lo que llena el autocompletado) ----------
    /** País (ISO) de la opción elegida en el selector: "AR", "PY"… ("" con "Otro país"). */
    const region = () => ccSel.selectedOptions[0]?.dataset.region ?? "";
    const setPlaceholder = () => (tel.placeholder = copy.fields.phonePlaceholderBy[ccSel.value] ?? copy.fields.phonePlaceholder);
    function normalizePhone() {
      const p = readPhone(tel.value, ccSel.value);
      if (!p.num) return;
      // el número trae otro código (+595…): se elige ese país en el selector
      if (p.cc && p.cc !== ccSel.value) {
        const opt = [...ccSel.options].find((o) => o.value === p.cc);
        if (opt) {
          ccSel.value = p.cc;
          setPlaceholder();
        }
      }
      // número válido: queda con el formato del país y sin el código (que ya está en el selector)
      if (p.ok) tel.value = telPrev = p.field;
    }
    tel.addEventListener("blur", normalizePhone);
    tel.addEventListener("change", normalizePhone); // autocompletado sin foco
    // Máscara mientras escribe (11 2345-6789 con +54). El cursor queda después del mismo dígito.
    let telPrev = "";
    const digitsOf = (v: string) => v.replace(/\D/g, "");
    tel.addEventListener("input", (e) => {
      let v = tel.value;
      let caret = tel.selectionStart ?? v.length;
