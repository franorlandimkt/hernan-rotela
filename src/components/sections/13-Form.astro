        const before = v.slice(0, caret).replace(/\d(?=\D*$)/, "");
        v = before + v.slice(caret);
        caret = before.length;
      }
      const masked = maskPhone(v, region());
      if (masked === null) return void (telPrev = tel.value);
      const n = digitsOf(v.slice(0, caret)).length;
      tel.value = masked;
      let pos = masked.length;
      if (digitsOf(masked) === digitsOf(v)) {
        if (n === 0) pos = /^\D*/.exec(masked)![0].length;
        let seen = 0;
        for (let i = 0; n > 0 && i < masked.length; i++) {
          if (/\d/.test(masked[i]) && ++seen === n) {
            pos = i + 1;
            break;
          }
        }
      }
      if (document.activeElement === tel) tel.setSelectionRange(pos, pos);
